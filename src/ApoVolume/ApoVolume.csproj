<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ApoVolume</AssemblyName>
    <ApplicationIcon>ApoVolume.ico</ApplicationIcon>
    <Version>2.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ApoVolume.Core\ApoVolume.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ApplicationIcon only stamps the Win32 icon on the exe (taskbar/alt-tab/Explorer). The
         same file is embedded as a WPF resource so the windows' Icon and the tray can load it. -->
    <Resource Include="ApoVolume.ico" />
  </ItemGroup>
</Project>
