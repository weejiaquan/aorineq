<Window x:Class="ApoVolume.UI.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" Height="64"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False">
    <Border CornerRadius="12" Background="#F2202020" Padding="16,0">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="GlyphText" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="White" VerticalAlignment="Center" Text="&#xE767;" />
            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                    IsMoveToPointEnabled="True" VerticalAlignment="Center"
                    ValueChanged="OnSliderValueChanged" />
            <TextBlock x:Name="PercentText" Grid.Column="2" Foreground="White" FontSize="16"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Text="50" />
        </Grid>
    </Border>
</Window>
