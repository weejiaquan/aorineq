<Window x:Class="ApoVolume.UI.SkinInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApoVolume" Icon="/ApoVolume.ico" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="True">
    <StackPanel Margin="20">
        <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                   Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray" Margin="0,0,0,4"
                   Text="The skin only downloads and installs if you continue. It changes how the volume OSD looks — nothing else." />
        <TextBlock x:Name="OverwriteText" TextWrapping="Wrap" FontSize="12" Foreground="#D32F2F"
                   Margin="0,4,0,0" Visibility="Collapsed"
                   Text="A skin with this name already exists and will be overwritten." />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="InstallUseButton" Content="Install &amp; Use" Padding="12,5"
                    Margin="0,0,8,0" IsDefault="True" Click="OnInstallUse" />
            <Button x:Name="InstallOnlyButton" Content="Install only" Padding="12,5"
                    Margin="0,0,8,0" Click="OnInstallOnly" />
            <Button x:Name="CancelButton" Content="Cancel" Padding="12,5" IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
