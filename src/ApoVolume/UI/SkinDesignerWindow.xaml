<Window x:Class="ApoVolume.UI.SkinDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApoVolume skin designer" Icon="/ApoVolume.ico" Width="880" Height="640"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- top bar: skin selector, name, zip sharing, save -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Skin:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="SkinSelect" Grid.Column="1" SelectionChanged="OnSkinSelected" />
            <TextBlock Grid.Column="2" Text="Name:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox x:Name="NameBox" Grid.Column="3" VerticalContentAlignment="Center" TextChanged="OnControlChanged" />
            <Button x:Name="ImportZipButton" Grid.Column="4" Content="Import…" Padding="10,4" Margin="12,0,0,0" Click="OnImportZip" />
            <Button x:Name="ExportZipButton" Grid.Column="5" Content="Export…" Padding="10,4" Margin="6,0,0,0" Click="OnExportZip" />
            <Button x:Name="SaveButton" Grid.Column="6" Content="Save" Padding="16,4" Margin="6,0,0,0" Click="OnSave" />
        </Grid>

        <!-- main: preview + controls -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#40808080" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <!-- Checkerboard sits behind the artwork so transparency is visible. -->
                    <Grid x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <Grid.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#FFF0F0F0">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,16,16" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#FFD4D4D4">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,8,8" />
                                                    <RectangleGeometry Rect="8,8,8,8" />
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.Background>
                        <!-- Same composition as SkinOsdWindow: empty under clipped full, text on top. -->
                        <Grid x:Name="PreviewCanvas"
                              MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove"
                              MouseLeftButtonUp="OnPreviewMouseUp">
                            <!-- EdgeMode=Aliased: same seam fix as SkinOsdWindow — AA'd
                                 complementary clips leak the backdrop through the boundary column. -->
                            <Image x:Name="EmptyImage" Stretch="Fill" RenderOptions.EdgeMode="Aliased" />
                            <Image x:Name="FullImage" Stretch="Fill" RenderOptions.EdgeMode="Aliased">
                                <Image.Clip>
                                    <RectangleGeometry x:Name="FillClip" />
                                </Image.Clip>
                            </Image>
                            <!-- Optional muted artwork, shown alone in mute preview (mirrors SkinOsdWindow). -->
                            <Image x:Name="MutedImage" Stretch="Fill" Visibility="Collapsed" />
                            <Path x:Name="PercentPath" HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Cursor="SizeAll" Visibility="Collapsed" />
                            <!-- Draggable fill-range handles: where 0% and 100% sit inside the artwork. -->
                            <Border x:Name="RangeStartHandle" Width="7" HorizontalAlignment="Left"
                                    Background="#800078D7" BorderBrush="#FF0078D7" BorderThickness="1,0"
                                    Cursor="SizeWE" Visibility="Collapsed"
                                    ToolTip="0% — drag to the bar's left edge" />
                            <Border x:Name="RangeEndHandle" Width="7" HorizontalAlignment="Left"
                                    Background="#80D77800" BorderBrush="#FFD77800" BorderThickness="1,0"
                                    Cursor="SizeWE" Visibility="Collapsed"
                                    ToolTip="100% — drag to the bar's right edge" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Images (PNG, sprite-sheet PNG, or GIF)" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="empty — artwork at 0%" FontSize="11" />
                <DockPanel Margin="0,2,0,6">
                    <Button DockPanel.Dock="Right" Content="Browse…" Padding="8,2" Click="OnBrowseEmpty" />
                    <Button DockPanel.Dock="Right" Content="Frames…" Padding="8,2" Margin="0,0,4,0" Click="OnImportEmptyFrames"
                            ToolTip="Build a sprite sheet from a numbered PNG frame sequence (e.g. Photoshop's Export Layers to Files)" />
                    <TextBlock x:Name="EmptyPathText" Text="—" FontSize="11" Foreground="Gray"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                </DockPanel>
                <TextBlock Text="full — artwork at 100%" FontSize="11" />
                <DockPanel Margin="0,2,0,4">
                    <Button DockPanel.Dock="Right" Content="Browse…" Padding="8,2" Click="OnBrowseFull" />
                    <Button DockPanel.Dock="Right" Content="Frames…" Padding="8,2" Margin="0,0,4,0" Click="OnImportFullFrames"
                            ToolTip="Build a sprite sheet from a numbered PNG frame sequence (e.g. Photoshop's Export Layers to Files)" />
                    <TextBlock x:Name="FullPathText" Text="—" FontSize="11" Foreground="Gray"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                </DockPanel>
                <TextBlock Text="muted — optional artwork while muted" FontSize="11" />
                <DockPanel Margin="0,2,0,4">
                    <Button DockPanel.Dock="Right" Content="Browse…" Padding="8,2" Click="OnBrowseMuted" />
                    <Button DockPanel.Dock="Right" Content="Frames…" Padding="8,2" Margin="0,0,4,0" Click="OnImportMutedFrames"
                            ToolTip="Build a sprite sheet from a numbered PNG frame sequence (e.g. Photoshop's Export Layers to Files)" />
                    <Button x:Name="ClearMutedButton" DockPanel.Dock="Right" Content="Clear" Padding="8,2" Margin="0,0,4,0"
                            Click="OnClearMuted" ToolTip="Remove the muted artwork and fall back to dimming" />
                    <TextBlock x:Name="MutedPathText" Text="—" FontSize="11" Foreground="Gray"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0" />
                </DockPanel>
                <TextBlock x:Name="ImageErrorText" Foreground="#D32F2F" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />

                <Separator Margin="0,4,0,8" />
                <TextBlock Text="Animation" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="fps" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                    <TextBox x:Name="FpsBox" Grid.Column="1" Text="10" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                    <TextBlock Grid.Column="2" Text="empty" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11"
                               ToolTip="Sprite-sheet frame count for the empty layer (GIFs are automatic)" />
                    <TextBox x:Name="EmptyFramesBox" Grid.Column="3" Text="1" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                    <TextBlock Grid.Column="4" Text="full" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11"
                               ToolTip="Sprite-sheet frame count for the full layer (GIFs are automatic)" />
                    <TextBox x:Name="FullFramesBox" Grid.Column="5" Text="1" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                    <TextBlock Grid.Column="6" Text="muted" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11"
                               ToolTip="Sprite-sheet frame count for the muted layer (GIFs are automatic)" />
                    <TextBox x:Name="MutedFramesBox" Grid.Column="7" Text="1" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                </Grid>

                <Separator Margin="0,4,0,8" />
                <TextBlock Text="Fill range" FontWeight="SemiBold" Margin="0,0,0,2"
                           ToolTip="Where the bar lives inside the image: 0% and 100% in image pixels. Drag the colored handles on the preview." />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="0% at" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                    <TextBox x:Name="FillStartBox" Grid.Column="1" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                    <TextBlock Grid.Column="3" Text="100% at" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                    <TextBox x:Name="FillEndBox" Grid.Column="4" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                </Grid>

                <Separator Margin="0,4,0,8" />
                <TextBlock Margin="0,0,0,2">
                    <Run Text="Fill preview: " /><Run x:Name="FillLabel" Text="62%" />
                </TextBlock>
                <Slider x:Name="FillSlider" Minimum="0" Maximum="100" Value="62"
                        ValueChanged="OnControlChanged" Margin="0,0,0,4" />
                <CheckBox x:Name="MuteCheck" Content="Preview mute"
                          Checked="OnControlChanged" Unchecked="OnControlChanged" Margin="0,0,0,4" />
                <TextBlock Margin="0,0,0,2"
                           ToolTip="Opacity of the dimmed artwork while muted — only used when the skin has no muted artwork">
                    <Run Text="Mute dim: " /><Run x:Name="MutedDimLabel" Text="0.60" />
                </TextBlock>
                <Slider x:Name="MutedDimSlider" Minimum="0" Maximum="1" Value="0.6"
                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                        ValueChanged="OnControlChanged" Margin="0,0,0,4" />

                <Separator Margin="0,4,0,8" />
                <CheckBox x:Name="ShowNumberCheck" Content="Show number (drag it on the preview)"
                          Checked="OnControlChanged" Unchecked="OnControlChanged" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="NumberXBox" Grid.Column="1" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                    <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="NumberYBox" Grid.Column="4" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                </Grid>

                <!-- Number text styling (enabled only while Show number is checked) -->
                <StackPanel x:Name="TextStylePanel">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Font" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                        <!-- Editable so a skin's font that isn't installed here is preserved verbatim
                             rather than silently rewritten. -->
                        <ComboBox x:Name="FontCombo" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True"
                                  SelectionChanged="OnControlChanged" LostFocus="OnControlChanged" />
                        <TextBlock Grid.Column="3" Text="Size" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                        <TextBox x:Name="FontSizeBox" Grid.Column="4" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="BoldCheck" Content="Bold" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="OnControlChanged" Unchecked="OnControlChanged" />
                        <TextBlock Text="Color" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                        <Button x:Name="TextColorSwatch" Width="28" Height="18" Click="OnPickTextColor"
                                ToolTip="Text color" />
                        <TextBlock Text="Align" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="11"
                                   ToolTip="What X anchors: the number's left edge, center, or right edge" />
                        <ComboBox x:Name="AlignCombo" Width="76" SelectionChanged="OnControlChanged">
                            <ComboBoxItem Content="Left" Tag="left" IsSelected="True" />
                            <ComboBoxItem Content="Center" Tag="center" />
                            <ComboBoxItem Content="Right" Tag="right" />
                        </ComboBox>
                    </StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="OutlineCheck" Grid.Column="0" Content="Outline" VerticalAlignment="Center"
                                  Margin="0,0,6,0" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                        <Button x:Name="OutlineColorSwatch" Grid.Column="1" Width="28" Height="18" Margin="0,0,8,0"
                                Click="OnPickOutlineColor" ToolTip="Outline color" />
                        <TextBlock Grid.Column="2" Text="Width" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                        <TextBox x:Name="OutlineWidthBox" Grid.Column="4" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ShadowCheck" Grid.Column="0" Content="Shadow" VerticalAlignment="Center"
                                  Margin="0,0,6,0" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                        <Button x:Name="ShadowColorSwatch" Grid.Column="1" Width="28" Height="18" Margin="0,0,8,0"
                                Click="OnPickShadowColor" ToolTip="Shadow color" />
                        <TextBlock Grid.Column="2" Text="Blur" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                        <TextBox x:Name="ShadowBlurBox" Grid.Column="3" Margin="0,0,8,0" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                        <TextBlock Grid.Column="4" Text="Depth" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                        <TextBox x:Name="ShadowDepthBox" Grid.Column="5" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                    </Grid>
                </StackPanel>

                <TextBlock Margin="0,0,0,2">
                    <Run Text="Scale: " /><Run x:Name="ScaleLabel" Text="1.00" />
                </TextBlock>
                <Slider x:Name="ScaleSlider" Minimum="0.25" Maximum="4" Value="1"
                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                        ValueChanged="OnControlChanged" Margin="0,0,0,8" />

                <Separator Margin="0,4,0,8" />
                <Button x:Name="TestButton" Content="Test on desktop" Padding="10,4" Click="OnTestOnDesktop" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" FontSize="11" Foreground="Gray"
                   Text="Pick two images (or an existing skin) to start. Change the name before saving to create a copy." />
    </Grid>
</Window>
