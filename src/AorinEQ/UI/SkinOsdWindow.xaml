<Window x:Class="AorinEQ.UI.SkinOsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" SizeToContent="Manual">
    <!-- The skin itself is drawn by SkinView, which the code-behind puts here. Everything this
         window adds is behaviour a TRANSIENT OSD needs and a persistent HUD widget does not:
         where it appears, the auto-hide fade, and drag/wheel-to-set-volume. The HUD's volume
         widget hosts the same SkinView with its own behaviour around it. -->
    <Grid x:Name="ViewHost" />
</Window>
