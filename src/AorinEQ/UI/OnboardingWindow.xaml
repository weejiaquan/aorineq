<Window x:Class="AorinEQ.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AorinEQ setup" Icon="/AorinEQ.ico" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <StackPanel Margin="24">
        <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"
                   Text="Set up Equalizer APO" />
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <!-- Volume-mode choice (first run and the Setup guide's opening page). -->
        <StackPanel x:Name="ModePanel" Visibility="Collapsed" Margin="0,0,0,10">
            <RadioButton x:Name="SystemModeRadio" GroupName="WizardVolumeMode" Margin="0,0,0,10">
                <StackPanel MaxWidth="430">
                    <TextBlock Text="Replace Windows volume" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                               Text="Volume keys change the normal Windows volume and show your skinned OSD instead of the Windows one. Using Equalizer APO for EQ/PEQ? Your EQ is never touched — set it once, control loudness natively." />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="EapoModeRadio" GroupName="WizardVolumeMode">
                <StackPanel MaxWidth="430">
                    <TextBlock Text="Equalizer APO preamp slider" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                               Text="Volume keys write Equalizer APO's preamp; Windows volume stays parked. Attenuation happens inside the APO chain before your EQ — for setups where the Windows volume path is broken or you want pre-DAC level control. Requires Equalizer APO." />
                </StackPanel>
            </RadioButton>
            <CheckBox x:Name="AutoUpdateBox" IsChecked="True" Margin="0,14,0,0"
                      Content="Keep AorinEQ up to date automatically" />
        </StackPanel>
        <TextBlock x:Name="GuidanceText" TextWrapping="Wrap" Margin="0,0,0,10"
                   FontWeight="SemiBold" Visibility="Collapsed" />
        <ProgressBar x:Name="DownloadProgress" Height="16" Margin="0,0,0,10" Visibility="Collapsed" />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#D32F2F" Margin="0,0,0,10"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button x:Name="PrimaryButton" Padding="14,6" Margin="0,0,8,0" Click="OnPrimary" />
            <Button x:Name="SecondaryButton" Padding="14,6" Margin="0,0,8,0" Click="OnSecondary" />
        </StackPanel>
        <TextBlock FontSize="11" Margin="0,12,0,0">
            <Hyperlink NavigateUri="https://equalizerapo.com" RequestNavigate="OnNavigate">equalizerapo.com</Hyperlink>
            <Run Text="  ·  Equalizer APO is free, open-source (GPLv2) software by Jonas Thedering." />
        </TextBlock>
    </StackPanel>
</Window>
