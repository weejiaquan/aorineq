<ui:FluentWindow x:Class="AorinEQ.UI.OnboardingWindow"
        xmlns:loc="clr-namespace:AorinEQ.UI"
        FontFamily="{StaticResource AppFontFamily}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{loc:T onboarding.window-title.aorineq-setup}" Icon="/AorinEQ.ico" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{loc:T onboarding.title.aorineq-setup}"
                     Icon="{ui:ImageIcon '/AorinEQ.ico'}" />
        <StackPanel Grid.Row="1" Margin="24">
            <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"
                       Text="{loc:T onboarding.heading.text}" />
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" Margin="0,0,0,10" />
            <!-- Volume-mode choice (first run and the Setup guide's opening page). -->
            <StackPanel x:Name="ModePanel" Visibility="Collapsed" Margin="0,0,0,10">
                <RadioButton x:Name="SystemModeRadio" GroupName="WizardVolumeMode" Margin="0,0,0,10">
                    <StackPanel MaxWidth="430">
                        <TextBlock Text="{loc:T onboarding.text.replace-windows-volume}" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:T onboarding.text.volume-keys-change-the}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="EapoModeRadio" GroupName="WizardVolumeMode">
                    <StackPanel MaxWidth="430">
                        <TextBlock Text="{loc:T onboarding.text.equalizer-apo-preamp-slider}" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:T onboarding.text.volume-keys-write-equalizer}" />
                    </StackPanel>
                </RadioButton>
                <CheckBox x:Name="AutoUpdateBox" IsChecked="True" Margin="0,14,0,0"
                          Content="{loc:T onboarding.auto-update.label}" />
            </StackPanel>
            <TextBlock x:Name="GuidanceText" TextWrapping="Wrap" Margin="0,0,0,10"
                       FontWeight="SemiBold" Visibility="Collapsed" />
            <ProgressBar x:Name="DownloadProgress" Height="16" Margin="0,0,0,10" Visibility="Collapsed" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,0,10"
                       Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="PrimaryButton" Padding="14,6" Margin="0,0,8,0" Click="OnPrimary" />
                <Button x:Name="SecondaryButton" Padding="14,6" Margin="0,0,8,0" Click="OnSecondary" />
            </StackPanel>
            <TextBlock FontSize="11" Margin="0,12,0,0">
                <Hyperlink NavigateUri="https://equalizerapo.com" RequestNavigate="OnNavigate">equalizerapo.com</Hyperlink>
                <Run Text="{loc:T onboarding.text.equalizer-apo-is-free}" />
            </TextBlock>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
