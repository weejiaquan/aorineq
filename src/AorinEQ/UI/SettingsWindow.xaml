<ui:FluentWindow x:Class="AorinEQ.UI.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AorinEQ settings" Icon="/AorinEQ.ico"
                 Width="900" Height="640"
                 MinWidth="720" MinHeight="440"
                 MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="True">
    <!-- MaxHeight stays bound to the work area: the v1.8.0 fix for a Settings window that grew
         past a short screen must not regress, and a NavigationView does not shrink content on its
         own. Each section scrolls inside itself, so the window never needs to grow to fit one. -->
    <Window.Resources>
        <!-- The card idiom for a settings row: icon + title + subtitle on the left, control on the
             right. Applied to every CardControl so the six sections stay visually identical. -->
        <!-- Cards inside a group sit tight; the air goes ABOVE the group heading instead, which
     is what makes a heading read as owning the cards under it rather than floating
     between them. Win11 Settings proportions. -->
        <Thickness x:Key="RowMargin">0,0,0,4</Thickness>
        <!-- Foreground is set EXPLICITLY on every text style here, and must stay that way. A bare
             ui:TextBlock that is not inside a themed container (a CardControl, say) does not
             inherit a theme foreground at all — it falls back to black, which on this window's dark
             Mica surface renders the page titles and group headings at 1.41:1. That is exactly the
             bug this release shipped and had to be pixel-sampled to find, because the card headers
             next to them looked fine. -->
        <Style x:Key="PageTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Title" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,28,0,8" />
        </Style>
        <!-- Card row titles. Inside a CardControl they inherit correctly today, but relying on that
             is what produced the defect above, so they say what they mean. -->
        <Style x:Key="RowTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Body" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- The 3x3 anchor picker. WPF-UI's implicit ToggleButton style is a pill whose checked
             state is a subtle fill — readable on a toolbar, but here nine of them sit side by side
             and the user has to see AT A GLANCE which corner is chosen, so the checked cell takes
             the system accent outright. -->
        <Style x:Key="AnchorCell" TargetType="ToggleButton"
               BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <!-- The primary TEXT brush, not the accent: the accent is whatever the user set
                         in Windows, and this machine's is black — an accent-filled cell on a dark
                         card would be invisible. The text brush is the one colour guaranteed to
                         contrast with the surface in either theme. -->
                    <Setter Property="Background" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Selected-state colouring for the volume-mode radios, applied for the same reason as
             AnchorCell above: WPF-UI paints a checked radio's fill from the ACCENT and its inner dot
             from the accent's foreground. With this machine's accent (black) that is a black dot on
             a grey ring — the selected option is invisible, which is precisely what was reported.
             Driving the fill from the primary TEXT brush makes the dot read against it in either
             theme, whatever accent the user has chosen. -->
        <Style x:Key="ModeRadio" TargetType="RadioButton"
               BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowSubtitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AorinEQ settings" Icon="{ui:ImageIcon '/AorinEQ.ico'}" />

        <ui:NavigationView x:Name="Nav" Grid.Row="1"
                           PaneDisplayMode="Left" OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True"
                           FrameMargin="0" TransitionDuration="120">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavVolume" Content="Volume" TargetPageTag="volume"
                                       Icon="{ui:SymbolIcon Speaker224}" />
                <ui:NavigationViewItem x:Name="NavOsd" Content="On-screen display" TargetPageTag="osd"
                                       Icon="{ui:SymbolIcon Desktop24}" />
                <ui:NavigationViewItem x:Name="NavSkins" Content="Skins" TargetPageTag="skins"
                                       Icon="{ui:SymbolIcon Color24}" />
                <ui:NavigationViewItem x:Name="NavEqualizer" Content="Equalizer" TargetPageTag="equalizer"
                                       Icon="{ui:SymbolIcon Options24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="NavUpdates" Content="Updates" TargetPageTag="updates"
                                       Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:NavigationViewItem x:Name="NavAbout" Content="About" TargetPageTag="about"
                                       Icon="{ui:SymbolIcon Info24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- The six section bodies. They are declared here, inside the window's namescope, so every
             control below keeps the generated field the code-behind already uses — a NavigationView
             page per section would have moved thirty named controls into six new namescopes and
             rewritten every handler for a release that changes no behaviour. At construction they
             are detached from this holder and handed to the NavigationView's frame one at a time
             (see SettingsWindow.Navigate), so exactly one is ever parented. The holder itself is
             collapsed and never renders. -->
        <Grid x:Name="SectionHolder" Grid.Row="1" Visibility="Collapsed">

            <!-- ============================ VOLUME ============================ -->
            <ScrollViewer x:Name="SectionVolume" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="Volume" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="How the volume keys change your loudness, and how far each press moves it. Both modes swallow the keys and show your own OSD; they differ in what the keys actually change." />

                    <ui:TextBlock Style="{StaticResource SectionHeading}" Text="Volume control" />
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Replace Windows volume" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="The keys move the normal Windows volume. Any Equalizer APO EQ you have set is left untouched." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <RadioButton x:Name="SystemModeRadio" GroupName="VolumeMode"
                                     Style="{StaticResource ModeRadio}"
                                     Checked="OnVolumeModeChanged" />
                    </ui:CardControl>
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Equalizer APO preamp slider" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="The keys write Equalizer APO's preamp, attenuating before your EQ. Requires Equalizer APO." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <RadioButton x:Name="EapoModeRadio" GroupName="VolumeMode"
                                     Style="{StaticResource ModeRadio}"
                                     Checked="OnVolumeModeChanged" />
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Volume key step size" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="How many percent one press of a volume key moves." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="StepCombo" MinWidth="110" SelectionChanged="OnStepChanged">
                            <ComboBoxItem Content="1%" Tag="1" />
                            <ComboBoxItem Content="2%" Tag="2" />
                            <ComboBoxItem Content="5%" Tag="5" />
                        </ComboBox>
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Per-device volume" />
                                <ui:TextBlock x:Name="DeviceVolumeText" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <!-- Startup lives here rather than in a section of its own: the elevation
                         setting exists only so the volume KEYS keep working while an elevated game
                         has focus, which makes it a volume concern more than a general one. -->
                    <ui:TextBlock Style="{StaticResource SectionHeading}" Text="Startup" />
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Start with Windows" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Launch AorinEQ automatically when you sign in." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="AutostartBox"
                                         Checked="OnAutostartChanged" Unchecked="OnAutostartChanged" />
                    </ui:CardControl>
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Run as administrator" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Required for the volume keys to work while elevated games are focused." />
                                <ui:TextBlock x:Name="ElevationStateText" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="RunAsAdminBox"
                                         Checked="OnRunAsAdminChanged" Unchecked="OnRunAsAdminChanged" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================== OSD ============================== -->
            <ScrollViewer x:Name="SectionOsd" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="On-screen display" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="The overlay that appears when you press a volume key." />

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Style" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Pick a built-in look, or your own skin." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="StyleCombo" MinWidth="160" SelectionChanged="OnStyleChanged">
                            <ComboBoxItem Content="Dark pill" Tag="dark-pill" />
                            <ComboBoxItem Content="Windows 11" Tag="fluent" />
                            <ComboBoxItem Content="Minimal bar" Tag="minimal-bar" />
                            <ComboBoxItem Content="Custom skin" Tag="skin" />
                        </ComboBox>
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Position" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Which screen edge or corner the OSD is anchored to." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <Grid Width="132" Height="132">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="AnchorTopLeft" Grid.Row="0" Grid.Column="0" Style="{StaticResource AnchorCell}" Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorTopCenter" Grid.Row="0" Grid.Column="1" Style="{StaticResource AnchorCell}" Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorTopRight" Grid.Row="0" Grid.Column="2" Style="{StaticResource AnchorCell}" Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorLeftCenter" Grid.Row="1" Grid.Column="0" Style="{StaticResource AnchorCell}" Click="OnAnchorClicked" />
                            <!-- Center cell: present but disabled/empty — the OSD can't be anchored to the screen
                                 center, only its 8 edges/corners, so this exists just to complete the 3x3 grid. -->
                            <ToggleButton Grid.Row="1" Grid.Column="1" Style="{StaticResource AnchorCell}" IsEnabled="False" IsHitTestVisible="False" />
                            <ToggleButton x:Name="AnchorRightCenter" Grid.Row="1" Grid.Column="2" Style="{StaticResource AnchorCell}" Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorBottomLeft" Grid.Row="2" Grid.Column="0" Style="{StaticResource AnchorCell}" Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorBottomCenter" Grid.Row="2" Grid.Column="1" Style="{StaticResource AnchorCell}" Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorBottomRight" Grid.Row="2" Grid.Column="2" Style="{StaticResource AnchorCell}" Click="OnAnchorClicked" />
                        </Grid>
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Offset" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Nudge the OSD away from its anchor, in pixels." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock VerticalAlignment="Center" Text="X" Margin="0,0,8,0" />
                            <ui:TextBox x:Name="OffsetXBox" Width="76" LostFocus="OnOffsetChanged" KeyDown="OnOffsetKeyDown" />
                            <ui:TextBlock VerticalAlignment="Center" Text="Y" Margin="12,0,8,0" />
                            <ui:TextBox x:Name="OffsetYBox" Width="76" LostFocus="OnOffsetChanged" KeyDown="OnOffsetKeyDown" />
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Hide delay" />
                                <ui:TextBlock x:Name="HideDelayLabel" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <Slider x:Name="HideDelaySlider" Width="200" Minimum="0.5" Maximum="5" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" ValueChanged="OnHideDelayChanged" />
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Animate fade-out" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Fade the OSD away instead of hiding it instantly." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="AnimationCheckBox"
                                         Checked="OnAnimationChanged" Unchecked="OnAnimationChanged" />
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Animation duration" />
                                <ui:TextBlock x:Name="AnimationDurationLabel" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <Slider x:Name="AnimationDurationSlider" Width="200" Minimum="50" Maximum="500"
                                ValueChanged="OnAnimationDurationChanged" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================= SKINS ============================= -->
            <ScrollViewer x:Name="SectionSkins" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="Skins" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="Custom OSD artwork. Skins are folders of images — design your own, or install one someone shared." />

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Active skin" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Used when the OSD style is set to Custom skin." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="SkinCombo" MinWidth="200" SelectionChanged="OnSkinChanged" />
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Manage skins" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Design a new skin, install one shared as a zip, or open the folder they live in." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="SkinDesignerButton" Content="Skin designer"
                                       Icon="{ui:SymbolIcon PaintBrush24}" Click="OnOpenSkinDesigner" />
                            <ui:Button x:Name="ImportSkinButton" Content="Import…" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnImportSkin"
                                       ToolTip="Install a skin shared as a zip file" />
                            <ui:Button x:Name="OpenSkinsFolderButton" Content="Folder" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon FolderOpen24}" Click="OnOpenSkinsFolder" />
                            <ui:Button x:Name="RescanSkinsButton" Content="Rescan" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRescanSkins" />
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Enable aorineq:// links" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Install shared skins and EQ presets straight from websites — always asks first." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="ProtocolLinksBox"
                                         Checked="OnProtocolLinksChanged" Unchecked="OnProtocolLinksChanged" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- =========================== EQUALIZER =========================== -->
            <ScrollViewer x:Name="SectionEqualizer" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="Equalizer" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="Per-device parametric EQ with presets, AutoEq profiles and live meters." />

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Equalizer editor" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Draggable curve, band strip, presets, AutoEq import and post-EQ meters." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button x:Name="OpenEqualizerButton" Content="Open equalizer"
                                   Icon="{ui:SymbolIcon Options24}" Click="OnOpenEqualizer" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ UPDATES ============================ -->
            <ScrollViewer x:Name="SectionUpdates" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="Updates" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="AorinEQ updates itself in place from its GitHub releases." />

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Keep AorinEQ up to date" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Check for a new version at startup and once a day, and install it automatically." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="AutoUpdateBox"
                                         Checked="OnAutoUpdateChanged" Unchecked="OnAutoUpdateChanged" />
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Check for updates" />
                                <ui:TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button x:Name="CheckUpdatesButton" Content="Check now"
                                   Icon="{ui:SymbolIcon ArrowSync24}" Click="OnCheckUpdates" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================= ABOUT ============================= -->
            <ScrollViewer x:Name="SectionAbout" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="About" />

                    <ui:CardControl Margin="0,8,0,8">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="A skinnable volume OSD and parametric equalizer for Windows." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <!-- Primary text, not the accent text brush. A hyperlink normally takes the
                             accent, but the accent is the user's choice and this machine's is black:
                             the link measured 2.37:1 against its card. A link nobody can read is not
                             a link, so legibility wins over the convention. -->
                        <ui:HyperlinkButton Content="View on GitHub"
                                            NavigateUri="https://github.com/weejiaquan/aorineq"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Icon="{ui:SymbolIcon Open24}" />
                    </ui:CardControl>

                    <ui:TextBlock Style="{StaticResource SectionHeading}" Text="Equalizer APO" />
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Status" />
                                <ui:TextBlock x:Name="EapoStatusText" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="SetupGuideButton" Content="Setup guide"
                                       Icon="{ui:SymbolIcon Book24}" Click="OnOpenSetupGuide" />
                            <ui:Button x:Name="OpenConfiguratorButton" Content="Configurator" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon Settings24}" Click="OnOpenConfigurator" />
                        </StackPanel>
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
