                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="{loc:T settings.tray-middle-click.title}" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="{loc:T settings.tray-middle-click.subtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="TrayMiddleClickCombo" MinWidth="190"
                                  SelectionChanged="OnTrayActionChanged" />
                    </ui:CardControl>
                    <ui:CardControl Margin="{StaticResource RowMargin}" help:Help.Topic="settings.tray-scroll">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="{loc:T settings.tray-scroll.title}" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="{loc:T settings.tray-scroll.subtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="TrayScrollBox"
                                         Checked="OnTrayToggleChanged" Unchecked="OnTrayToggleChanged" />
                    </ui:CardControl>
                    <ui:CardControl Margin="{StaticResource RowMargin}" help:Help.Topic="settings.scroll-inverted">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="{loc:T settings.scroll-inverted.title}" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="{loc:T settings.scroll-inverted.subtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="ScrollInvertedBox"
                                         Checked="OnTrayToggleChanged" Unchecked="OnTrayToggleChanged" />
                    </ui:CardControl>

                    <!-- STARTUP AND ELEVATION. The reason to run elevated is still a volume one
                         — it is what keeps the volume KEYS working while an elevated game has focus
                         — but it is set once and then never touched, which makes it a property of
                         the installation rather than a volume control. The help topic still
                         explains the volume reason, because that is what the switch is FOR. -->
                    <ui:TextBlock Style="{StaticResource SectionHeading}" Text="{loc:T settings.heading.startup}" />
                    <ui:CardControl Margin="{StaticResource RowMargin}" help:Help.Topic="settings.autostart">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="{loc:T settings.autostart.title}" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="{loc:T settings.autostart.subtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="AutostartBox"
                                         Checked="OnAutostartChanged" Unchecked="OnAutostartChanged" />
                    </ui:CardControl>
                    <ui:CardControl Margin="{StaticResource RowMargin}" help:Help.Topic="settings.elevation-state">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="{loc:T settings.elevation-state.title}" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="{loc:T settings.elevation-state.subtitle}" />
                                <ui:TextBlock x:Name="ElevationStateText" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="RunAsAdminBox"
                                         Checked="OnRunAsAdminChanged" Unchecked="OnRunAsAdminChanged" />
                    </ui:CardControl>

                    <!-- LINKS. The aorineq:// handler: whether a link on a page or in a chat can
                         hand this app a skin or a preset to install. -->
                    <ui:TextBlock Style="{StaticResource SectionHeading}" Text="{loc:T settings.heading.links}" />
                    <ui:CardControl Margin="{StaticResource RowMargin}" help:Help.Topic="settings.protocol-links">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="{loc:T settings.protocol-links.title}" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="{loc:T settings.protocol-links.subtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="ProtocolLinksBox"
                                         Checked="OnProtocolLinksChanged" Unchecked="OnProtocolLinksChanged" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ UPDATES ============================ -->
            <ScrollViewer x:Name="SectionUpdates" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="{loc:T settings.page-title.updates}" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="{loc:T settings.section-updates.subtitle}" />

                    <ui:CardControl Margin="{StaticResource RowMargin}" help:Help.Topic="settings.auto-update">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="{loc:T settings.auto-update.title}" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="{loc:T settings.auto-update.subtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="AutoUpdateBox"
                                         Checked="OnAutoUpdateChanged" Unchecked="OnAutoUpdateChanged" />
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}" help:Help.Topic="settings.update-status">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="{loc:T settings.update-status.title}" />
                                <ui:TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button x:Name="CheckUpdatesButton" Content="{loc:T settings.check-updates.label}"
                                   Icon="{ui:SymbolIcon ArrowSync24}" Click="OnCheckUpdates" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================= ABOUT ============================= -->
            <ScrollViewer x:Name="SectionAbout" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="{loc:T settings.page-title.about}" />

                    <ui:CardControl Margin="0,8,0,8">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="{loc:T settings.version.subtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <!-- Primary text, not the accent text brush. A hyperlink normally takes the
                             accent, but the accent is the user's choice and this machine's is black:
                             the link measured 2.37:1 against its card. A link nobody can read is not
                             a link, so legibility wins over the convention. -->
                        <ui:HyperlinkButton Content="{loc:T settings.version.label}"
                                            NavigateUri="https://github.com/weejiaquan/aorineq"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Icon="{ui:SymbolIcon Open24}" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
