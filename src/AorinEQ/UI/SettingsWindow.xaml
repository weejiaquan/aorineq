                                          Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorTopRight" Grid.Row="0" Grid.Column="2" Style="{StaticResource AnchorCell}"
                                          AutomationProperties.Name="Top right" ToolTip="{loc:T settings.anchor-top-right.tooltip}"
                                          Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorLeftCenter" Grid.Row="1" Grid.Column="0" Style="{StaticResource AnchorCell}"
                                          AutomationProperties.Name="Left centre" ToolTip="{loc:T settings.anchor-left-center.tooltip}"
                                          Click="OnAnchorClicked" />
                            <!-- The centre is not an anchor — the OSD attaches to the 8 edges and corners only. It
                                 is drawn as an empty gap rather than a ninth square: now that the cells fill their
                                 slots, a filled centre is indistinguishable from a real target and invites a click
                                 that can never do anything. Inert three ways over (disabled, no hit test, no tab
                                 stop) and still named, so a screen reader explains the hole rather than skipping it. -->
                            <ToggleButton Grid.Row="1" Grid.Column="1" Style="{StaticResource AnchorCell}"
                                          Background="Transparent" BorderBrush="Transparent"
                                          IsEnabled="False" IsHitTestVisible="False" IsTabStop="False"
                                          AutomationProperties.Name="Centre (not an anchor)" />
                            <ToggleButton x:Name="AnchorRightCenter" Grid.Row="1" Grid.Column="2" Style="{StaticResource AnchorCell}"
                                          AutomationProperties.Name="Right centre" ToolTip="{loc:T settings.anchor-right-center.tooltip}"
