<ui:FluentWindow x:Class="AorinEQ.UI.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AorinEQ settings" Icon="/AorinEQ.ico"
                 Width="900" Height="640"
                 MinWidth="720" MinHeight="440"
                 MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="True">
    <!-- MaxHeight stays bound to the work area: the v1.8.0 fix for a Settings window that grew
         past a short screen must not regress, and a NavigationView does not shrink content on its
         own. Each section scrolls inside itself, so the window never needs to grow to fit one. -->
    <Window.Resources>
        <!-- The card idiom for a settings row: icon + title + subtitle on the left, control on the
             right. Applied to every CardControl so the six sections stay visually identical. -->
        <!-- Cards inside a group sit tight; the air goes ABOVE the group heading instead, which
     is what makes a heading read as owning the cards under it rather than floating
     between them. Win11 Settings proportions. -->
        <Thickness x:Key="RowMargin">0,0,0,4</Thickness>
        <!-- Foreground is set EXPLICITLY on every text style here, and must stay that way. A bare
             ui:TextBlock that is not inside a themed container (a CardControl, say) does not
             inherit a theme foreground at all — it falls back to black, which on this window's dark
             Mica surface renders the page titles and group headings at 1.41:1. That is exactly the
             bug this release shipped and had to be pixel-sampled to find, because the card headers
             next to them looked fine. -->
        <Style x:Key="PageTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Title" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,28,0,8" />
        </Style>
        <!-- Card row titles. Inside a CardControl they inherit correctly today, but relying on that
             is what produced the defect above, so they say what they mean. -->
        <Style x:Key="RowTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Body" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- The 3x3 anchor picker. WPF-UI's implicit ToggleButton style is a pill whose checked
             state is a subtle fill — readable on a toolbar, but here nine of them sit side by side
             and the user has to see AT A GLANCE which corner is chosen, so the checked cell takes
             the system accent outright. -->
        <Style x:Key="AnchorCell" TargetType="ToggleButton"
               BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="3" />
            <!-- These four are what make the cell CLICKABLE, and none of them is cosmetic.
                 An anchor cell has no Content, so with the library's default centred alignment the
                 button sized itself to its (empty) content: measured 2x2 PIXELS inside the 38x38 the
                 grid had reserved, with a hit-test at every one of 49 probe points across that slot
                 landing on the Border behind it — 0% of the area the user is aiming at. That is the
                 "I have to spam click and get lucky" report. Stretch makes the button occupy its
                 whole slot; an explicit Background makes that whole area hit-testable, because a
                 null Background is transparent to hit testing and would hand the clicks straight
                 back to the Border. MinWidth/MinHeight stay pinned to 0 so the library's own minimum
                 button size cannot blow the 3x3 grid out of its 132px box. -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <!-- The primary TEXT brush, not the accent: the accent is whatever the user set
                         in Windows, and this machine's is black — an accent-filled cell on a dark
                         card would be invisible. The text brush is the one colour guaranteed to
                         contrast with the surface in either theme. -->
                    <Setter Property="Background" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Selected-state colouring for the volume-mode radios, applied for the same reason as
             AnchorCell above: WPF-UI paints a checked radio's fill from the ACCENT and its inner dot
             from the accent's foreground. With this machine's accent (black) that is a black dot on
             a grey ring — the selected option is invisible, which is precisely what was reported.
             Driving the fill from the primary TEXT brush makes the dot read against it in either
             theme, whatever accent the user has chosen. -->
        <Style x:Key="ModeRadio" TargetType="RadioButton"
               BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowSubtitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- Who made the skin the user is running. Caption-sized like a subtitle but on the PRIMARY
             foreground on purpose: a credit is the answer to a question the user asked, not
             explanatory chrome, and TextFillColorSecondaryBrush measures ~3.15:1 in light theme. -->
        <!-- The Equalizer APO health banner's headline. BodyStrong so it outranks a card title,
             and — like every other text style here — it states its own Foreground, because a
             ui:TextBlock outside a themed container falls back to black. -->
        <Style x:Key="BannerTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- The banner's explanation. On the PRIMARY foreground, not the secondary one the card
             subtitles use: this is the text that tells someone why their volume stopped working,
             and TextFillColorSecondaryBrush measures ~3.15:1 in light theme. -->
        <Style x:Key="BannerBody" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Body" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- One fact of the health row: label on the left, value on the right. Both on the primary
             foreground — the value is the answer, and the label is what makes it mean anything. -->
        <Style x:Key="HealthLabel" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="Margin" Value="0,0,16,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- The value is the answer, so it is the heavier of the pair. FontWeight rather than a
             FontTypography of its own: WPF-UI 4.3.0's FontTypography has exactly Caption, Body,
             BodyStrong, Subtitle, Title, TitleLarge and Display — there is no "CaptionStrong", and
             naming one compiles perfectly and then throws a XamlParseException the first time the
             window is constructed. -->
        <Style x:Key="HealthValue" TargetType="ui:TextBlock" BasedOn="{StaticResource HealthLabel}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SkinCredit" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AorinEQ settings" Icon="{ui:ImageIcon '/AorinEQ.ico'}" />

        <ui:NavigationView x:Name="Nav" Grid.Row="1"
                           PaneDisplayMode="Left" OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True"
                           FrameMargin="0" TransitionDuration="120">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavVolume" Content="Volume" TargetPageTag="volume"
                                       Icon="{ui:SymbolIcon Speaker224}" />
                <ui:NavigationViewItem x:Name="NavOsd" Content="On-screen display" TargetPageTag="osd"
                                       Icon="{ui:SymbolIcon Desktop24}" />
                <ui:NavigationViewItem x:Name="NavSkins" Content="Skins" TargetPageTag="skins"
                                       Icon="{ui:SymbolIcon Color24}" />
                <ui:NavigationViewItem x:Name="NavEqualizer" Content="Equalizer" TargetPageTag="equalizer"
                                       Icon="{ui:SymbolIcon Options24}" />
                <ui:NavigationViewItem x:Name="NavHud" Content="HUD widgets" TargetPageTag="hud"
                                       Icon="{ui:SymbolIcon DataHistogram24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="NavUpdates" Content="Updates" TargetPageTag="updates"
                                       Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:NavigationViewItem x:Name="NavAbout" Content="About" TargetPageTag="about"
                                       Icon="{ui:SymbolIcon Info24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- The six section bodies. They are declared here, inside the window's namescope, so every
             control below keeps the generated field the code-behind already uses — a NavigationView
             page per section would have moved thirty named controls into six new namescopes and
             rewritten every handler for a release that changes no behaviour. At construction they
             are detached from this holder and handed to the NavigationView's frame one at a time
             (see SettingsWindow.Navigate), so exactly one is ever parented. The holder itself is
             collapsed and never renders. -->
        <Grid x:Name="SectionHolder" Grid.Row="1" Visibility="Collapsed">

            <!-- ============================ VOLUME ============================ -->
            <ScrollViewer x:Name="SectionVolume" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="Volume" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="How the volume keys change your loudness, and how far each press moves it. Both modes swallow the keys and show your own OSD; they differ in what the keys actually change." />

                    <!-- EQUALIZER APO HEALTH BANNER. Collapsed whenever there is nothing wrong, so
                         it is never decoration; when it appears it is the first thing on the page,
                         above the very setting it is about.

                         Deliberately NOT ui:InfoBar: this is the surface that has to be legible on
                         the day the user's volume stops working, so every colour in it is one this
                         window already proves it can read, and its two buttons are real buttons
                         with real hit areas rather than a library control's inline links.

                         The Grid (rather than a horizontal StackPanel) is what lets the headline
                         wrap beside the icon instead of running off the edge at 720px. -->
                    <Border x:Name="EapoBanner" Visibility="Collapsed" Margin="0,0,0,8"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="16,14,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="20"
                                           Margin="0,1,12,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock x:Name="EapoBannerTitle" Style="{StaticResource BannerTitle}" />
                                <ui:TextBlock x:Name="EapoBannerBody" Style="{StaticResource BannerBody}" />
                                <WrapPanel Margin="0,14,0,0">
                                    <ui:Button x:Name="EapoBannerRepairButton" Margin="0,0,8,0"
                                               Icon="{ui:SymbolIcon Wrench24}"
                                               Click="OnEapoRepair" />
                                    <!-- The filled one, because it is the difference between a dead
                                         app and a working one: it makes the volume keys work again
                                         on the next press. Filled from the primary TEXT brush and
                                         lettered in the window background, NOT from Appearance
                                         ="Primary" — that paints from the Windows accent, and this
                                         machine's accent is black (see the ModeRadio style). -->
                                    <ui:Button x:Name="EapoSwitchModeButton"
                                               Content="Switch to Windows volume mode"
                                               Icon="{ui:SymbolIcon Speaker224}"
                                               Background="{DynamicResource TextFillColorPrimaryBrush}"
                                               BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                               Foreground="{DynamicResource ApplicationBackgroundBrush}"
                                               Click="OnEapoSwitchMode" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ui:TextBlock Style="{StaticResource SectionHeading}" Text="Volume control" />
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Replace Windows volume" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="The keys move the normal Windows volume. Any Equalizer APO EQ you have set is left untouched." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <RadioButton x:Name="SystemModeRadio" GroupName="VolumeMode"
                                     Style="{StaticResource ModeRadio}"
                                     Checked="OnVolumeModeChanged" />
                    </ui:CardControl>
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Equalizer APO preamp slider" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="The keys write Equalizer APO's preamp, attenuating before your EQ. Requires Equalizer APO." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <RadioButton x:Name="EapoModeRadio" GroupName="VolumeMode"
                                     Style="{StaticResource ModeRadio}"
                                     Checked="OnVolumeModeChanged" />
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Volume key step size" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="How many percent one press of a volume key moves." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="StepCombo" MinWidth="110" SelectionChanged="OnStepChanged">
                            <ComboBoxItem Content="1%" Tag="1" />
                            <ComboBoxItem Content="2%" Tag="2" />
                            <ComboBoxItem Content="5%" Tag="5" />
                        </ComboBox>
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Per-device volume" />
                                <ui:TextBlock x:Name="DeviceVolumeText" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <!-- Startup lives here rather than in a section of its own: the elevation
                         setting exists only so the volume KEYS keep working while an elevated game
                         has focus, which makes it a volume concern more than a general one. -->
                    <ui:TextBlock Style="{StaticResource SectionHeading}" Text="Startup" />
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Start with Windows" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Launch AorinEQ automatically when you sign in." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="AutostartBox"
                                         Checked="OnAutostartChanged" Unchecked="OnAutostartChanged" />
                    </ui:CardControl>
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Run as administrator" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Required for the volume keys to work while elevated games are focused." />
                                <ui:TextBlock x:Name="ElevationStateText" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="RunAsAdminBox"
                                         Checked="OnRunAsAdminChanged" Unchecked="OnRunAsAdminChanged" />
                    </ui:CardControl>

                    <!-- EQUALIZER APO HEALTH. This lived in About until 3.4.0, where it was a
                         one-line status nobody had a reason to visit. It belongs here: whether
                         Equalizer APO is actually processing audio is the single thing that decides
                         whether APO preamp mode works at all, and this is the page that offers that
                         mode. About keeps the version and the repository link.

                         Three separate facts rather than one status word, because they fail
                         independently and the fix differs: installed is about the program, enabled
                         is about the DEVICE (the one a Windows update resets), and the settings
                         link is about Equalizer APO's own config file. -->
                    <ui:TextBlock x:Name="EapoHealthHeading" Style="{StaticResource SectionHeading}"
                                  Text="Equalizer APO health" />
                    <!-- Everything lives in the HEADER, with nothing in the card's content slot.
                         A CardControl lays its header and its content out side by side, and this
                         header is wide (the longest fact label is a sentence): measured at 900x640,
                         the button column landed ON TOP of the fact values, and at 720x440 the last
                         button was under the scrollbar's arrow. Stacked, the card simply grows and
                         the section scrolls, which it already does. -->
                    <ui:CardControl x:Name="EapoHealthCard" Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                          <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource HealthLabel}"
                                              Text="Installed" />
                                <ui:TextBlock x:Name="HealthInstalledValue" Grid.Row="0" Grid.Column="1"
                                              Style="{StaticResource HealthValue}" />
                                <ui:TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource HealthLabel}"
                                              Text="Switched on for the device you're using" />
                                <ui:TextBlock x:Name="HealthActiveValue" Grid.Row="1" Grid.Column="1"
                                              Style="{StaticResource HealthValue}" />
                                <ui:TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource HealthLabel}"
                                              Text="Reading AorinEQ's settings" />
                                <ui:TextBlock x:Name="HealthIncludeValue" Grid.Row="2" Grid.Column="1"
                                              Style="{StaticResource HealthValue}" />
                                <ui:TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource HealthLabel}"
                                              Text="Last checked" />
                                <ui:TextBlock x:Name="HealthCheckedValue" Grid.Row="3" Grid.Column="1"
                                              Style="{StaticResource HealthValue}" />
                            </Grid>
                            <WrapPanel Margin="0,14,0,0">
                                <ui:Button x:Name="SetupGuideButton" Content="Setup guide" Margin="0,0,8,4"
                                           Icon="{ui:SymbolIcon Book24}" Click="OnOpenSetupGuide" />
                                <ui:Button x:Name="OpenConfiguratorButton" Content="Configurator" Margin="0,0,8,4"
                                           Icon="{ui:SymbolIcon Settings24}" Click="OnOpenConfigurator" />
                                <!-- Never automatic and never silent: the click is the consent, and
                                     the confirmation it raises spells out the administrator prompt,
                                     the audio interruption and the undo before anything is written. -->
                                <ui:Button x:Name="RepairEapoButton" Content="Repair automatically" Margin="0,0,8,4"
                                           Icon="{ui:SymbolIcon Wrench24}" Click="OnRepairEapo" />
                                <ui:Button x:Name="UndoRepairButton" Content="Undo repair" Margin="0,0,0,4"
                                           Visibility="Collapsed"
                                           Icon="{ui:SymbolIcon ArrowUndo24}" Click="OnUndoEapoRepair" />
                            </WrapPanel>
                            <ui:TextBlock x:Name="EapoRepairStatusText" Style="{StaticResource RowSubtitle}"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Margin="0,8,0,0" Visibility="Collapsed" />
                          </StackPanel>
                        </ui:CardControl.Header>
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================== OSD ============================== -->
            <ScrollViewer x:Name="SectionOsd" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="On-screen display" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="The overlay that appears when you press a volume key." />

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Style" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Pick a built-in look, or your own skin." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="StyleCombo" MinWidth="160" SelectionChanged="OnStyleChanged">
                            <ComboBoxItem Content="Dark pill" Tag="dark-pill" />
                            <ComboBoxItem Content="Windows 11" Tag="fluent" />
                            <ComboBoxItem Content="Minimal bar" Tag="minimal-bar" />
                            <ComboBoxItem Content="Custom skin" Tag="skin" />
                        </ComboBox>
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Position" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Which screen edge or corner the OSD is anchored to." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <Grid Width="132" Height="132">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="AnchorTopLeft" Grid.Row="0" Grid.Column="0" Style="{StaticResource AnchorCell}"
                                          AutomationProperties.Name="Top left" ToolTip="Top left"
                                          Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorTopCenter" Grid.Row="0" Grid.Column="1" Style="{StaticResource AnchorCell}"
                                          AutomationProperties.Name="Top centre" ToolTip="Top centre"
                                          Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorTopRight" Grid.Row="0" Grid.Column="2" Style="{StaticResource AnchorCell}"
                                          AutomationProperties.Name="Top right" ToolTip="Top right"
                                          Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorLeftCenter" Grid.Row="1" Grid.Column="0" Style="{StaticResource AnchorCell}"
                                          AutomationProperties.Name="Left centre" ToolTip="Left centre"
                                          Click="OnAnchorClicked" />
                            <!-- The centre is not an anchor — the OSD attaches to the 8 edges and corners only. It
                                 is drawn as an empty gap rather than a ninth square: now that the cells fill their
                                 slots, a filled centre is indistinguishable from a real target and invites a click
                                 that can never do anything. Inert three ways over (disabled, no hit test, no tab
                                 stop) and still named, so a screen reader explains the hole rather than skipping it. -->
                            <ToggleButton Grid.Row="1" Grid.Column="1" Style="{StaticResource AnchorCell}"
                                          Background="Transparent" BorderBrush="Transparent"
                                          IsEnabled="False" IsHitTestVisible="False" IsTabStop="False"
                                          AutomationProperties.Name="Centre (not an anchor)" />
                            <ToggleButton x:Name="AnchorRightCenter" Grid.Row="1" Grid.Column="2" Style="{StaticResource AnchorCell}"
                                          AutomationProperties.Name="Right centre" ToolTip="Right centre"
                                          Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorBottomLeft" Grid.Row="2" Grid.Column="0" Style="{StaticResource AnchorCell}"
                                          AutomationProperties.Name="Bottom left" ToolTip="Bottom left"
                                          Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorBottomCenter" Grid.Row="2" Grid.Column="1" Style="{StaticResource AnchorCell}"
                                          AutomationProperties.Name="Bottom centre" ToolTip="Bottom centre"
                                          Click="OnAnchorClicked" />
                            <ToggleButton x:Name="AnchorBottomRight" Grid.Row="2" Grid.Column="2" Style="{StaticResource AnchorCell}"
                                          AutomationProperties.Name="Bottom right" ToolTip="Bottom right"
                                          Click="OnAnchorClicked" />
                        </Grid>
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Offset" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Nudge the OSD away from its anchor, in pixels." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock VerticalAlignment="Center" Text="X" Margin="0,0,8,0" />
                            <ui:TextBox x:Name="OffsetXBox" Width="76" LostFocus="OnOffsetChanged" KeyDown="OnOffsetKeyDown" />
                            <ui:TextBlock VerticalAlignment="Center" Text="Y" Margin="12,0,8,0" />
                            <ui:TextBox x:Name="OffsetYBox" Width="76" LostFocus="OnOffsetChanged" KeyDown="OnOffsetKeyDown" />
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Hide delay" />
                                <ui:TextBlock x:Name="HideDelayLabel" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <Slider x:Name="HideDelaySlider" Width="200" Minimum="0.5" Maximum="5" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" ValueChanged="OnHideDelayChanged" />
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Animate fade-out" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Fade the OSD away instead of hiding it instantly." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="AnimationCheckBox"
                                         Checked="OnAnimationChanged" Unchecked="OnAnimationChanged" />
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Animation duration" />
                                <ui:TextBlock x:Name="AnimationDurationLabel" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <Slider x:Name="AnimationDurationSlider" Width="200" Minimum="50" Maximum="500"
                                ValueChanged="OnAnimationDurationChanged" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================= SKINS ============================= -->
            <!-- ============================== HUD ============================== -->
            <ScrollViewer x:Name="SectionHud" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="HUD widgets" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="Small always-on-top panels showing your own audio: the spectrum after your EQ, your output levels and clipping, your EQ curve, and your volume. They stay out of your way — never in Alt+Tab, never focused, and click-through unless you are arranging them." />

                    <ui:TextBlock Style="{StaticResource SectionHeading}" Text="Mode" />
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Arrange widgets" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="On: widgets can be dragged, resized and right-clicked for their own settings. Off: they are completely click-through, so a click over one reaches whatever is underneath." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="HudEditSwitch" Click="OnHudEditToggled" />
                    </ui:CardControl>

                    <ui:TextBlock Style="{StaticResource SectionHeading}" Text="Your widgets" />
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Add a widget" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="A new widget appears on your main screen, ready to drag into place." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <WrapPanel>
                            <ui:Button x:Name="AddSpectrumButton" Content="Spectrum" Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon DataHistogram24}" Click="OnAddSpectrum" />
                            <ui:Button x:Name="AddLevelsButton" Content="Levels" Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon DataBarVertical24}" Click="OnAddLevels" />
                            <ui:Button x:Name="AddEqCurveButton" Content="EQ curve" Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon Options24}" Click="OnAddEqCurve" />
                            <ui:Button x:Name="AddVolumeButton" Content="Volume"
                                       Icon="{ui:SymbolIcon Speaker224}" Click="OnAddVolume" />
                        </WrapPanel>
                    </ui:CardControl>

                    <ui:TextBlock x:Name="HudEmptyText" Style="{StaticResource RowSubtitle}"
                                  Margin="0,8,0,0" Text="No widgets yet." />
                    <ItemsControl x:Name="HudWidgetList" Margin="0,4,0,0" />

                    <ui:TextBlock Style="{StaticResource SectionHeading}" Text="Behaviour" />
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Hide while a fullscreen app is in front" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Overlays over exclusive-fullscreen games either flicker or do not draw at all, so hiding them is better than showing them badly." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="HudFullscreenSwitch" Click="OnHudBehaviourChanged" />
                    </ui:CardControl>
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Show only while audio is playing" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="The widgets appear when sound starts and fade out a few seconds after it stops." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="HudOnlyPlayingSwitch" Click="OnHudBehaviourChanged" />
                    </ui:CardControl>
                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Refresh rate" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="How often every widget redraws. One timer serves all of them; lower it if you would rather spend nothing at all on the HUD." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="HudFpsCombo" MinWidth="160" SelectionChanged="OnHudFpsChanged">
                            <ComboBoxItem Content="10 fps" Tag="10" />
                            <ComboBoxItem Content="20 fps" Tag="20" />
                            <ComboBoxItem Content="30 fps" Tag="30" />
                            <ComboBoxItem Content="60 fps" Tag="60" />
                        </ComboBox>
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SectionSkins" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="Skins" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="Custom OSD artwork. Skins are folders of images — design your own, or install one someone shared." />

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Active skin" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Used when the OSD style is set to Custom skin." />
                                <!-- Credits for the selected skin. Collapsed (not blank) when the
                                     skin carries none, so an uncredited skin costs no layout. -->
                                <ui:TextBlock x:Name="SkinCreditText" Style="{StaticResource SkinCredit}"
                                              Visibility="Collapsed" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="SkinCombo" MinWidth="200" SelectionChanged="OnSkinChanged" />
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Manage skins" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Design a new skin, install one shared as a zip, or open the folder they live in." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="SkinDesignerButton" Content="Skin designer"
                                       Icon="{ui:SymbolIcon PaintBrush24}" Click="OnOpenSkinDesigner" />
                            <ui:Button x:Name="ImportSkinButton" Content="Import…" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnImportSkin"
                                       ToolTip="Install a skin shared as a zip file" />
                            <ui:Button x:Name="OpenSkinsFolderButton" Content="Folder" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon FolderOpen24}" Click="OnOpenSkinsFolder" />
                            <ui:Button x:Name="RescanSkinsButton" Content="Rescan" Margin="8,0,0,0"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRescanSkins" />
                        </StackPanel>
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Enable aorineq:// links" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Install shared skins and EQ presets straight from websites — always asks first." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="ProtocolLinksBox"
                                         Checked="OnProtocolLinksChanged" Unchecked="OnProtocolLinksChanged" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- =========================== EQUALIZER =========================== -->
            <ScrollViewer x:Name="SectionEqualizer" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="Equalizer" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="Per-device parametric EQ with presets, AutoEq profiles and live meters." />

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Equalizer editor" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Draggable curve, band strip, presets, AutoEq import and post-EQ meters." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button x:Name="OpenEqualizerButton" Content="Open equalizer"
                                   Icon="{ui:SymbolIcon Options24}" Click="OnOpenEqualizer" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ UPDATES ============================ -->
            <ScrollViewer x:Name="SectionUpdates" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="Updates" />
                    <ui:TextBlock Style="{StaticResource RowSubtitle}" Margin="0,0,0,24"
                                  Text="AorinEQ updates itself in place from its GitHub releases." />

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Keep AorinEQ up to date" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="Check for a new version at startup and once a day, and install it automatically." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="AutoUpdateBox"
                                         Checked="OnAutoUpdateChanged" Unchecked="OnAutoUpdateChanged" />
                    </ui:CardControl>

                    <ui:CardControl Margin="{StaticResource RowMargin}">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource RowTitle}" Text="Check for updates" />
                                <ui:TextBlock x:Name="UpdateStatusText" Style="{StaticResource RowSubtitle}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button x:Name="CheckUpdatesButton" Content="Check now"
                                   Icon="{ui:SymbolIcon ArrowSync24}" Click="OnCheckUpdates" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================= ABOUT ============================= -->
            <ScrollViewer x:Name="SectionAbout" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="About" />

                    <ui:CardControl Margin="0,8,0,8">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" />
                                <ui:TextBlock Style="{StaticResource RowSubtitle}"
                                              Text="A skinnable volume OSD and parametric equalizer for Windows." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <!-- Primary text, not the accent text brush. A hyperlink normally takes the
                             accent, but the accent is the user's choice and this machine's is black:
                             the link measured 2.37:1 against its card. A link nobody can read is not
                             a link, so legibility wins over the convention. -->
                        <ui:HyperlinkButton Content="View on GitHub"
                                            NavigateUri="https://github.com/weejiaquan/aorineq"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Icon="{ui:SymbolIcon Open24}" />
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
