                                  Text="{loc:T settings.section-general.subtitle}" />

                    <!-- TRAY ICON. Moved here from the Volume page in 3.8.0: what a click on the
                         icon DOES is a property of the app, not of the volume, and the Volume page
                         had grown into two unrelated halves. The two combos are filled from
                         TrayActions in code-behind, so an action added there appears here without
                         touching this file — and can never appear under its raw persisted name. -->
                    <ui:TextBlock Style="{StaticResource SectionHeading}" Text="{loc:T settings.heading.tray-icon}" />
                    <ui:CardControl Margin="{StaticResource RowMargin}" help:Help.Topic="settings.tray-left-click">
                        <ui:CardControl.Header>
