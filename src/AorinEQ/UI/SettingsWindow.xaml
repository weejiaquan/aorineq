            <!-- AorinEQ configuring ITSELF, as opposed to the sound it makes. Added in 3.8.0 to
                 take the second half of the Volume page, which had quietly become two pages: four
                 controls about loudness followed by six about the app. Protocol links came from
                 the Skins page, where they had never belonged — an aorineq:// handler has nothing
                 to do with OSD artwork; that was simply the page with room at the time.

                 The section TAG is "general", not "settings", though this is what the sidebar
                 calls it. See SettingsSections.General for why the obvious name was taken. -->
            <ScrollViewer x:Name="SectionGeneral" VerticalScrollBarVisibility="Auto" Padding="28,20,28,28">
                <StackPanel>
                    <ui:TextBlock Style="{StaticResource PageTitle}" Text="{loc:T settings.page-title.general}" />
