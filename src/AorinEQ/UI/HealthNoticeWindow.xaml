<ui:FluentWindow x:Class="AorinEQ.UI.HealthNoticeWindow"
        xmlns:loc="clr-namespace:AorinEQ.UI"
        FontFamily="{StaticResource AppFontFamily}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AorinEQ" Icon="/AorinEQ;component/AorinEQ.ico" Width="380" MinWidth="0" MinHeight="0" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <StackPanel Margin="16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Image Source="/AorinEQ;component/AorinEQ.ico" Width="16" Height="16" Margin="0,0,8,0" />
            <TextBlock Text="AorinEQ" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ActionButton" Padding="14,6" Margin="0,0,8,0" Click="OnAction"
                    Content="{loc:T tray.action.settings.name}" />
            <Button x:Name="DismissButton" Padding="14,6" Click="OnDismiss"
                    Content="{loc:T health-notice.dismiss}" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
