<ui:FluentWindow x:Class="AorinEQ.UI.SkinInstallDialog"
        xmlns:loc="clr-namespace:AorinEQ.UI"
        FontFamily="{StaticResource AppFontFamily}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AorinEQ" Icon="/AorinEQ.ico" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="AorinEQ"
                     Icon="{ui:ImageIcon '/AorinEQ.ico'}" />
        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"
                       Text="{loc:T dialog.skininstall.text.the-skin-only-downloads}" />
            <TextBlock x:Name="OverwriteText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Margin="0,4,0,0" Visibility="Collapsed"
                       Text="{loc:T dialog.skininstall.overwrite.text}" />
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="InstallUseButton" Content="{loc:T dialog.skininstall.install-use.label}" Padding="12,5"
                        Margin="0,0,8,0" IsDefault="True" Click="OnInstallUse" />
                <Button x:Name="InstallOnlyButton" Content="{loc:T dialog.skininstall.install-only.label}" Padding="12,5"
                        Margin="0,0,8,0" Click="OnInstallOnly" />
                <Button x:Name="CancelButton" Content="{loc:T dialog.skininstall.cancel.label}" Padding="12,5" IsCancel="True"
                        Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
