<Window x:Class="AorinEQ.UI.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" Height="64"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False">
    <Grid>
        <!-- dark-pill style: rounded pill, glyph + slider + percent, drop shadow -->
        <Border x:Name="DarkPillRoot" CornerRadius="12" Background="#F2202020" Padding="16,10">
            <Border.Effect>
                <DropShadowEffect Opacity="0.4" BlurRadius="16" ShadowDepth="0" />
            </Border.Effect>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GlyphText" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                           Foreground="White" VerticalAlignment="Center" Text="&#xE767;" />
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center"
                        ValueChanged="OnSliderValueChanged" />
                <TextBlock x:Name="PercentText" Grid.Column="2" Foreground="White" FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Text="50" />
            </Grid>
        </Border>

        <!-- minimal-bar style: thin track + percent chip toward screen center, no glyph -->
        <Grid x:Name="MinimalBarRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="MinimalChip" Grid.Row="0" HorizontalAlignment="Center"
                    Margin="0,0,0,4" CornerRadius="8" Background="#F2202020" Padding="8,2">
                <TextBlock x:Name="MinimalPercentText" Foreground="White" FontSize="12"
                           FontWeight="SemiBold" Text="50" />
            </Border>
            <Grid x:Name="MinimalTrackHost" Grid.Row="1">
                <Border Height="6" VerticalAlignment="Center" CornerRadius="3" Background="#40FFFFFF" />
                <Border x:Name="MinimalFill" Height="6" Width="0" VerticalAlignment="Center"
                        HorizontalAlignment="Left" CornerRadius="3" Background="White" />
                <!-- Fully transparent but still hit-testable: gives the thin decorative bar
                     above a real, default-behaved Slider (drag / click-to-jump / keyboard) for
                     the interactive surface, without hand-rolling a custom ControlTemplate. -->
                <Slider x:Name="MinimalSlider" Minimum="0" Maximum="100" Opacity="0"
                        IsMoveToPointEnabled="True" ValueChanged="OnSliderValueChanged" />
            </Grid>
        </Grid>

        <!-- fluent style: Win11-esque light/dark panel, glyph + slider + percent layout like
             dark-pill. Background/border/text/accent colors depend on the live registry-read
             theme and accent (SystemTheme), so they aren't set here — OsdWindow.xaml.cs's
             ApplyFluentTheme() sets them fresh on every ShowVolume. Track fill and thumb reuse
             minimal-bar's "decorative visuals + transparent overlay Slider" trick (see
             MinimalBarRoot above) rather than a custom Slider ControlTemplate, since elements
             named inside a ControlTemplate live in the template's own namescope and aren't
             reachable as ordinary code-behind fields the way these plain, top-level-named
             elements are. -->
        <Border x:Name="FluentRoot" Visibility="Collapsed" CornerRadius="8" BorderThickness="1" Padding="16,10">
            <Border.Effect>
                <DropShadowEffect Opacity="0.3" BlurRadius="16" ShadowDepth="0" />
            </Border.Effect>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FluentGlyphText" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                           VerticalAlignment="Center" Text="&#xE767;" />
                <Grid x:Name="FluentTrackHost" Grid.Column="1" VerticalAlignment="Center" Height="14">
                    <Border x:Name="FluentTrackTail" Height="4" VerticalAlignment="Center" CornerRadius="2" />
                    <Border x:Name="FluentTrackFill" Height="4" Width="0" VerticalAlignment="Center"
                            HorizontalAlignment="Left" CornerRadius="2" />
                    <Ellipse x:Name="FluentThumbRing" Width="14" Height="14" HorizontalAlignment="Left" />
                    <Ellipse x:Name="FluentThumbCenter" Width="6" Height="6" HorizontalAlignment="Left" />
                    <!-- Fully transparent but still hit-testable: same trick as MinimalSlider,
                         gives the decorative track/thumb above a real, default-behaved Slider
                         (drag / click-to-jump / keyboard) for the interactive surface. -->
                    <Slider x:Name="FluentSlider" Minimum="0" Maximum="100" Opacity="0"
                            IsMoveToPointEnabled="True" ValueChanged="OnSliderValueChanged" />
                </Grid>
                <TextBlock x:Name="FluentPercentText" Grid.Column="2" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Text="50" />
            </Grid>
        </Border>
    </Grid>
</Window>
