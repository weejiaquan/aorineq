<ui:FluentWindow x:Class="AorinEQ.UI.EqEditorWindow"
        xmlns:loc="clr-namespace:AorinEQ.UI"
        FontFamily="{StaticResource AppFontFamily}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{loc:T eq.window-title.equalizer-aorineq}" Icon="/AorinEQ.ico" Width="1000" Height="640"
        MinWidth="820" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource EqPanelBrush}" Focusable="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{loc:T eq.title.equalizer-aorineq}"
                     Icon="{ui:ImageIcon '/AorinEQ.ico'}" />
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Scope tabs: Global + one per render device; the Windows-default device is marked.
                 The Simple/Advanced switch sits on the same line, right-aligned. -->
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="10,0,0,0">
                <TextBlock Text="{loc:T eq.text.mode}" Foreground="{DynamicResource EqTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <RadioButton x:Name="SimpleModeRadio" Content="{loc:T eq.simple-mode.label}" GroupName="EditorMode"
                             Foreground="{DynamicResource EqTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                             Checked="OnEditorModeChanged"
                             ToolTip="{loc:T eq.simple-mode.tooltip}" />
                <RadioButton x:Name="AdvancedModeRadio" Content="{loc:T eq.advanced-mode.label}" GroupName="EditorMode"
                             Foreground="{DynamicResource EqTextBrush}" VerticalAlignment="Center"
                             Checked="OnEditorModeChanged"
                             ToolTip="{loc:T eq.advanced-mode.tooltip}" />
            </StackPanel>
            <ListBox x:Name="ScopeTabs" SelectionChanged="OnScopeSelected"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Setter Property="Foreground" Value="#DDD" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                            Background="{DynamicResource EqPanelBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D6EB5" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#556" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            </DockPanel>

            <!-- Preset bar. WrapPanel, not DockPanel: at narrow widths the trailing controls must
                 wrap to a second line instead of being clipped off the right edge. Simple mode keeps
                 the preset picker, Flatten, the on/off switch and auto-preamp; the rest is the full
                 editor's toolkit and collapses. -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Text="{loc:T eq.text.preset}" Foreground="{DynamicResource EqTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="PresetCombo" Width="230" SelectionChanged="OnPresetSelected" />
                <StackPanel x:Name="AdvancedPresetTools" Orientation="Horizontal">
                    <Button Content="{loc:T eq.advanced-preset-tools.label}" Padding="10,3" Margin="6,0,0,0" Click="OnSavePreset" />
                    <Button Content="{loc:T eq.advanced-preset-tools.label-2}" Padding="10,3" Margin="4,0,0,0" Click="OnSavePresetAs" />
                    <Button Content="{loc:T eq.advanced-preset-tools.label-3}" Padding="10,3" Margin="4,0,0,0" Click="OnDeletePreset" />
                    <Button Content="{loc:T eq.advanced-preset-tools.label-4}" Padding="10,3" Margin="10,0,0,0" Click="OnImportFile" />
                    <Button Content="{loc:T eq.advanced-preset-tools.label-5}" Padding="10,3" Margin="4,0,0,0" Click="OnAutoEq" />
                    <Button Content="{loc:T eq.advanced-preset-tools.label-6}" Padding="10,3" Margin="10,0,0,0" Click="OnEditAsText"
                            ToolTip="{loc:T eq.advanced-preset-tools.tooltip}" />
                    <Button Content="{loc:T eq.advanced-preset-tools.label-7}" Padding="10,3" Margin="4,0,0,0" Click="OnCopyShareLink"
                            ToolTip="{loc:T eq.advanced-preset-tools.tooltip-2}" />
                </StackPanel>
                <Button Content="{loc:T eq.label.flatten}" Padding="10,3" Margin="10,0,0,0" Click="OnFlatten"
                        ToolTip="{loc:T eq.tooltip.set-every-band-s}" />
                <Button x:Name="ClearAllButton" Content="{loc:T eq.clear-all.label}" Padding="10,3" Margin="4,0,0,0"
                        Click="OnClearBands" ToolTip="{loc:T eq.clear-all.tooltip}" />
                <CheckBox x:Name="EqEnabledCheck" Content="{loc:T eq.eq-enabled.label}" Foreground="{DynamicResource EqTextBrush}"
                          VerticalAlignment="Center" Margin="16,0,0,0" Checked="OnEqEnabledChanged"
                          Unchecked="OnEqEnabledChanged" />
                <Button Content="{loc:T eq.label.auto-preamp}" Padding="10,3" Margin="14,0,0,0" Click="OnAutoPreamp"
                        ToolTip="{loc:T eq.tooltip.set-the-preset-preamp}" />
                <TextBlock x:Name="PreampReadout" Foreground="{DynamicResource EqCurveBrush}" VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </WrapPanel>

            <!-- Plot + side panel -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- 170 of content plus the 22 the scrollbar and its gutter take, so the
                         controls keep the width they had before the panel started scrolling. -->
                    <ColumnDefinition Width="192" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource EqPlotBrush}" CornerRadius="6" ClipToBounds="True">
                    <Canvas x:Name="Plot" Background="Transparent" ClipToBounds="True"
                            SizeChanged="OnPlotSizeChanged"
                            MouseLeftButtonDown="OnPlotMouseDown" MouseMove="OnPlotMouseMove"
                            MouseLeftButtonUp="OnPlotMouseUp" MouseWheel="OnPlotMouseWheel"
                            MouseRightButtonUp="OnPlotRightClick"
                            LostMouseCapture="OnPlotLostCapture" />
                </Border>

                <!-- In Advanced mode this column is ~490px of controls, and at MinHeight 520 the
                     row that holds it gets ~120 — everything from Gain down to the level readout
                     was not merely clipped but painted over by the band strip below, which is
                     declared after it and has an opaque background. It scrolls now. -->
                <ScrollViewer Grid.Column="1" Margin="10,0,0,0" Padding="0,0,8,0" Focusable="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Per-band controls: the full editor only. The meters below stay in both
                         modes — knowing how loud it is matters just as much with three sliders. -->
                    <StackPanel x:Name="BandPanel">
                    <TextBlock Text="{loc:T eq.text.selected-band}" Foreground="{DynamicResource EqTextBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:T eq.text.type}" Foreground="{DynamicResource EqTextDimBrush}" Margin="0,8,0,2" FontSize="11" />
                    <ComboBox x:Name="BandTypeCombo" SelectionChanged="OnBandTypeChanged" />
                    <TextBlock Text="{loc:T eq.text.frequency-hz}" Foreground="{DynamicResource EqTextDimBrush}" Margin="0,8,0,2" FontSize="11" />
                    <TextBox x:Name="FcBox" LostFocus="OnBandBoxCommit" KeyDown="OnBandBoxKeyDown" />
                    <TextBlock Text="{loc:T eq.text.gain-db}" Foreground="{DynamicResource EqTextDimBrush}" Margin="0,8,0,2" FontSize="11" />
                    <TextBox x:Name="GainBox" LostFocus="OnBandBoxCommit" KeyDown="OnBandBoxKeyDown" />
                    <TextBlock Text="Q" Foreground="{DynamicResource EqTextDimBrush}" Margin="0,8,0,2" FontSize="11" />
                    <TextBox x:Name="QBox" LostFocus="OnBandBoxCommit" KeyDown="OnBandBoxKeyDown" />
                    <Button x:Name="RemoveBandButton" Content="{loc:T eq.remove-band.label}" Padding="8,3" Margin="0,10,0,0"
                            Click="OnRemoveBand" />
                    <Button x:Name="DbRangeButton" Padding="8,3" Margin="0,8,0,0" Click="OnToggleDbRange" />
                    </StackPanel>

                    <TextBlock Text="{loc:T eq.text.output-level-post-eq}" Foreground="{DynamicResource EqTextBrush}" FontWeight="SemiBold"
                               Margin="0,18,0,4" />
                    <Grid Height="120">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource EqMeterTrackBrush}" Margin="0,0,4,0" CornerRadius="2">
                            <Grid>
                                <Rectangle x:Name="RmsBarL" Fill="{DynamicResource EqMeterRmsBrush}" VerticalAlignment="Bottom" Height="0" />
                                <Rectangle x:Name="PeakTickL" Fill="{DynamicResource EqMeterPeakBrush}" VerticalAlignment="Bottom"
                                           Height="2" Margin="0,0,0,0" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource EqMeterTrackBrush}" Margin="0,0,4,0" CornerRadius="2">
                            <Grid>
                                <Rectangle x:Name="RmsBarR" Fill="{DynamicResource EqMeterRmsBrush}" VerticalAlignment="Bottom" Height="0" />
                                <Rectangle x:Name="PeakTickR" Fill="{DynamicResource EqMeterPeakBrush}" VerticalAlignment="Bottom"
                                           Height="2" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <Button x:Name="ClipIndicator" Content="{loc:T eq.clip-indicator.label}" FontWeight="Bold" FontSize="11"
                                    Padding="6,2" Background="{DynamicResource EqClipIdleBrush}" Foreground="{DynamicResource EqClipIdleTextBrush}"
                                    ToolTip="{loc:T eq.clip-indicator.tooltip}"
                                    Click="OnResetClip" />
                            <TextBlock x:Name="ClipCountText" Foreground="{DynamicResource EqTextDimBrush}" FontSize="11"
                                       Margin="0,4,0,0" Text="" />
                            <TextBlock x:Name="LevelText" Foreground="{DynamicResource EqTextDimBrush}" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Simple mode: three macro sliders over the SAME bands the strip below edits. -->
            <Border x:Name="SimplePanel" Grid.Row="3" Background="{DynamicResource EqPlotBrush}" CornerRadius="6"
                    Margin="0,8,0,0" Padding="10,8" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="62" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T eq.text.bass}" Foreground="{DynamicResource EqTextBrush}"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="BassSlider" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                TickFrequency="6" TickPlacement="BottomRight"
                                ValueChanged="OnMacroSliderChanged" />
                        <TextBlock x:Name="BassReadout" Grid.Row="0" Grid.Column="2" Foreground="{DynamicResource EqCurveBrush}"
                                   VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T eq.text.mid}" Foreground="{DynamicResource EqTextBrush}"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="MidSlider" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                TickFrequency="6" TickPlacement="BottomRight"
                                ValueChanged="OnMacroSliderChanged" />
                        <TextBlock x:Name="MidReadout" Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource EqCurveBrush}"
                                   VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T eq.text.treble}" Foreground="{DynamicResource EqTextBrush}"
                                   VerticalAlignment="Center" />
                        <Slider x:Name="TrebleSlider" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                                Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                TickFrequency="6" TickPlacement="BottomRight"
                                ValueChanged="OnMacroSliderChanged" />
                        <TextBlock x:Name="TrebleReadout" Grid.Row="2" Grid.Column="2" Foreground="{DynamicResource EqCurveBrush}"
                                   VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                    <!-- Says so out loud when this scope already has other bands: they are left
                         exactly as they are, and nothing here silently discards them. -->
                    <TextBlock x:Name="SimpleNoteText" Foreground="{DynamicResource EqNodeSelectedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,6,0,0" Text="" />
                </StackPanel>
            </Border>

            <!-- Peace-style band strip: one typable column per band, no fixed band count. -->
            <Border x:Name="BandStripPanel" Grid.Row="3" Background="{DynamicResource EqPlotBrush}" CornerRadius="6"
                    Margin="0,8,0,0" Padding="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button x:Name="AddBandButton" Content="+" FontSize="17" FontWeight="Bold"
                                Width="34" Height="34" Click="OnAddBand"
                                ToolTip="{loc:T eq.add-band.tooltip}" />
                        <TextBlock x:Name="BandCountText" Foreground="{DynamicResource EqClipIdleTextBrush}" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="StripHintText" DockPanel.Dock="Right" Foreground="{DynamicResource EqNodeSelectedBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                               TextWrapping="Wrap" MaxWidth="150" Text="" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BandStrip" Orientation="Horizontal" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
