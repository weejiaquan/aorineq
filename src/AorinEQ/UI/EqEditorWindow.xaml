<Window x:Class="AorinEQ.UI.EqEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equalizer — AorinEQ" Icon="/AorinEQ.ico" Width="1000" Height="640"
        MinWidth="820" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="#FF1E1E24" Focusable="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scope tabs: Global + one per render device; the Windows-default device is marked.
             The Simple/Advanced switch sits on the same line, right-aligned. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="10,0,0,0">
            <TextBlock Text="Mode:" Foreground="#BBB" VerticalAlignment="Center" Margin="0,0,6,0" />
            <RadioButton x:Name="SimpleModeRadio" Content="Simple" GroupName="EditorMode"
                         Foreground="#DDD" VerticalAlignment="Center" Margin="0,0,10,0"
                         Checked="OnEditorModeChanged"
                         ToolTip="Bass, mid and treble sliders — the same EQ, three controls" />
            <RadioButton x:Name="AdvancedModeRadio" Content="Advanced" GroupName="EditorMode"
                         Foreground="#DDD" VerticalAlignment="Center"
                         Checked="OnEditorModeChanged"
                         ToolTip="The full parametric editor: every band, presets, AutoEq" />
        </StackPanel>
        <ListBox x:Name="ScopeTabs" SelectionChanged="OnScopeSelected"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,4" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="Foreground" Value="#DDD" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                        Background="#2A2A33">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#3D6EB5" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#556" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        </DockPanel>

        <!-- Preset bar. WrapPanel, not DockPanel: at narrow widths the trailing controls must
             wrap to a second line instead of being clipped off the right edge. Simple mode keeps
             the preset picker, Flatten, the on/off switch and auto-preamp; the rest is the full
             editor's toolkit and collapses. -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal">
            <TextBlock Text="Preset:" Foreground="#BBB" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="PresetCombo" Width="230" SelectionChanged="OnPresetSelected" />
            <StackPanel x:Name="AdvancedPresetTools" Orientation="Horizontal">
                <Button Content="Save" Padding="10,3" Margin="6,0,0,0" Click="OnSavePreset" />
                <Button Content="Save As…" Padding="10,3" Margin="4,0,0,0" Click="OnSavePresetAs" />
                <Button Content="Delete" Padding="10,3" Margin="4,0,0,0" Click="OnDeletePreset" />
                <Button Content="Import file…" Padding="10,3" Margin="10,0,0,0" Click="OnImportFile" />
                <Button Content="AutoEq…" Padding="10,3" Margin="4,0,0,0" Click="OnAutoEq" />
                <Button Content="Edit as text…" Padding="10,3" Margin="10,0,0,0" Click="OnEditAsText"
                        ToolTip="Type or paste a whole ParametricEQ block at once" />
                <Button Content="Copy share link" Padding="10,3" Margin="4,0,0,0" Click="OnCopyShareLink"
                        ToolTip="Copy an aorineq:// link containing this whole chain — paste it anywhere and whoever clicks it sees this tuning" />
            </StackPanel>
            <Button Content="Flatten" Padding="10,3" Margin="10,0,0,0" Click="OnFlatten"
                    ToolTip="Set every band's gain (and this scope's preset preamp) to 0 dB" />
            <Button x:Name="ClearAllButton" Content="Clear all" Padding="10,3" Margin="4,0,0,0"
                    Click="OnClearBands" ToolTip="Remove every band from this scope" />
            <CheckBox x:Name="EqEnabledCheck" Content="EQ enabled" Foreground="#DDD"
                      VerticalAlignment="Center" Margin="16,0,0,0" Checked="OnEqEnabledChanged"
                      Unchecked="OnEqEnabledChanged" />
            <Button Content="Auto-preamp" Padding="10,3" Margin="14,0,0,0" Click="OnAutoPreamp"
                    ToolTip="Set the preset preamp to cancel the chain's maximum boost" />
            <TextBlock x:Name="PreampReadout" Foreground="#9AC" VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </WrapPanel>

        <!-- Plot + side panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF15151A" CornerRadius="6" ClipToBounds="True">
                <Canvas x:Name="Plot" Background="Transparent" ClipToBounds="True"
                        SizeChanged="OnPlotSizeChanged"
                        MouseLeftButtonDown="OnPlotMouseDown" MouseMove="OnPlotMouseMove"
                        MouseLeftButtonUp="OnPlotMouseUp" MouseWheel="OnPlotMouseWheel"
                        MouseRightButtonUp="OnPlotRightClick"
                        LostMouseCapture="OnPlotLostCapture" />
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <!-- Per-band controls: the full editor only. The meters below stay in both
                     modes — knowing how loud it is matters just as much with three sliders. -->
                <StackPanel x:Name="BandPanel">
                <TextBlock Text="Selected band" Foreground="#BBB" FontWeight="SemiBold" />
                <TextBlock Text="Type" Foreground="#999" Margin="0,8,0,2" FontSize="11" />
                <ComboBox x:Name="BandTypeCombo" SelectionChanged="OnBandTypeChanged" />
                <TextBlock Text="Frequency (Hz)" Foreground="#999" Margin="0,8,0,2" FontSize="11" />
                <TextBox x:Name="FcBox" LostFocus="OnBandBoxCommit" KeyDown="OnBandBoxKeyDown" />
                <TextBlock Text="Gain (dB)" Foreground="#999" Margin="0,8,0,2" FontSize="11" />
                <TextBox x:Name="GainBox" LostFocus="OnBandBoxCommit" KeyDown="OnBandBoxKeyDown" />
                <TextBlock Text="Q" Foreground="#999" Margin="0,8,0,2" FontSize="11" />
                <TextBox x:Name="QBox" LostFocus="OnBandBoxCommit" KeyDown="OnBandBoxKeyDown" />
                <Button x:Name="RemoveBandButton" Content="Remove band" Padding="8,3" Margin="0,10,0,0"
                        Click="OnRemoveBand" />
                <Button x:Name="DbRangeButton" Padding="8,3" Margin="0,8,0,0" Click="OnToggleDbRange" />
                </StackPanel>

                <TextBlock Text="Output level (post-EQ)" Foreground="#BBB" FontWeight="SemiBold"
                           Margin="0,18,0,4" />
                <Grid Height="120">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#26262E" Margin="0,0,4,0" CornerRadius="2">
                        <Grid>
                            <Rectangle x:Name="RmsBarL" Fill="#4C9F6E" VerticalAlignment="Bottom" Height="0" />
                            <Rectangle x:Name="PeakTickL" Fill="#C8E6C9" VerticalAlignment="Bottom"
                                       Height="2" Margin="0,0,0,0" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#26262E" Margin="0,0,4,0" CornerRadius="2">
                        <Grid>
                            <Rectangle x:Name="RmsBarR" Fill="#4C9F6E" VerticalAlignment="Bottom" Height="0" />
                            <Rectangle x:Name="PeakTickR" Fill="#C8E6C9" VerticalAlignment="Bottom"
                                       Height="2" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                        <Button x:Name="ClipIndicator" Content="CLIP" FontWeight="Bold" FontSize="11"
                                Padding="6,2" Background="#333" Foreground="#777"
                                ToolTip="Latches on peaks ≥ −0.1 dBFS; click to reset"
                                Click="OnResetClip" />
                        <TextBlock x:Name="ClipCountText" Foreground="#999" FontSize="11"
                                   Margin="0,4,0,0" Text="" />
                        <TextBlock x:Name="LevelText" Foreground="#888" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Simple mode: three macro sliders over the SAME bands the strip below edits. -->
        <Border x:Name="SimplePanel" Grid.Row="3" Background="#FF15151A" CornerRadius="6"
                Margin="0,8,0,0" Padding="10,8" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Bass" Foreground="#DDD"
                               VerticalAlignment="Center" />
                    <Slider x:Name="BassSlider" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                            Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                            TickFrequency="6" TickPlacement="BottomRight"
                            ValueChanged="OnMacroSliderChanged" />
                    <TextBlock x:Name="BassReadout" Grid.Row="0" Grid.Column="2" Foreground="#9AC"
                               VerticalAlignment="Center" TextAlignment="Right" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mid" Foreground="#DDD"
                               VerticalAlignment="Center" />
                    <Slider x:Name="MidSlider" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                            Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                            TickFrequency="6" TickPlacement="BottomRight"
                            ValueChanged="OnMacroSliderChanged" />
                    <TextBlock x:Name="MidReadout" Grid.Row="1" Grid.Column="2" Foreground="#9AC"
                               VerticalAlignment="Center" TextAlignment="Right" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Treble" Foreground="#DDD"
                               VerticalAlignment="Center" />
                    <Slider x:Name="TrebleSlider" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                            Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                            TickFrequency="6" TickPlacement="BottomRight"
                            ValueChanged="OnMacroSliderChanged" />
                    <TextBlock x:Name="TrebleReadout" Grid.Row="2" Grid.Column="2" Foreground="#9AC"
                               VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
                <!-- Says so out loud when this scope already has other bands: they are left
                     exactly as they are, and nothing here silently discards them. -->
                <TextBlock x:Name="SimpleNoteText" Foreground="#D08A50" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0" Text="" />
            </StackPanel>
        </Border>

        <!-- Peace-style band strip: one typable column per band, no fixed band count. -->
        <Border x:Name="BandStripPanel" Grid.Row="3" Background="#FF15151A" CornerRadius="6"
                Margin="0,8,0,0" Padding="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button x:Name="AddBandButton" Content="+" FontSize="17" FontWeight="Bold"
                            Width="34" Height="34" Click="OnAddBand"
                            ToolTip="Add a band (then type its frequency)" />
                    <TextBlock x:Name="BandCountText" Foreground="#777" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock x:Name="StripHintText" DockPanel.Dock="Right" Foreground="#D08A50"
                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                           TextWrapping="Wrap" MaxWidth="150" Text="" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BandStrip" Orientation="Horizontal" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
