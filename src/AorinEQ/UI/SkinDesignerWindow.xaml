<ui:FluentWindow x:Class="AorinEQ.UI.SkinDesignerWindow"
        xmlns:loc="clr-namespace:AorinEQ.UI"
        FontFamily="{StaticResource AppFontFamily}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{loc:T designer.window-title.aorineq-skin-designer}" Icon="/AorinEQ;component/AorinEQ.ico"
        Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- The title is set in code as well: it gains a "•" while the skin has unsaved changes. -->
        <ui:TitleBar x:Name="DesignerTitleBar" Grid.Row="0" Title="{loc:T designer.title.aorineq-skin-designer}"
                     Icon="{ui:ImageIcon '/AorinEQ;component/AorinEQ.ico'}" />

        <!-- Top bar: which skin, the file actions, history - and, on the right, what uses the skin. -->
        <DockPanel Grid.Row="1" Margin="12,0,12,8" LastChildFill="False">
            <TextBlock Text="{loc:T designer.text.skin}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="SkinSelect" Width="220" SelectionChanged="OnSkinSelected" />
            <Button x:Name="NewButton" Content="{loc:T designer.new.label}" Padding="10,4" Margin="12,0,0,0" Click="OnNew" />
            <Button x:Name="ImportZipButton" Content="{loc:T designer.import-zip.label}" Padding="10,4" Margin="6,0,0,0" Click="OnImportZip" />
            <Button x:Name="ExportZipButton" Content="{loc:T designer.export-zip.label}" Padding="10,4" Margin="6,0,0,0" Click="OnExportZip" />
            <ui:Button x:Name="UndoButton" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="16,0,0,0" Click="OnUndo"
                       ToolTip="{loc:T designer.undo.tooltip}" ToolTipService.ShowOnDisabled="True" />
            <ui:Button x:Name="RedoButton" Icon="{ui:SymbolIcon ArrowRedo24}" Margin="6,0,0,0" Click="OnRedo"
                       ToolTip="{loc:T designer.redo.tooltip}" ToolTipService.ShowOnDisabled="True" />
            <StackPanel x:Name="SkinActions" DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ShareButton" Content="{loc:T designer.share.label}" Padding="10,4" Click="OnShare"
                        ToolTip="{loc:T designer.share.tooltip}" />
                <Button x:Name="TestButton" Content="{loc:T designer.test.label}" Padding="10,4" Margin="6,0,0,0"
                        Click="OnTestOnDesktop" />
                <ui:Button x:Name="SaveButton" Content="{loc:T designer.save.label}" Appearance="Primary" Padding="16,4"
                           Margin="6,0,0,0" Click="OnSave" ToolTipService.ShowOnDisabled="True" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LayersColumn" Width="220" MinWidth="160" MaxWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PropertiesColumn" Width="320" MinWidth="160" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{loc:T designer.layers.title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TreeView x:Name="LayersTree" SelectedItemChanged="OnLayerSelected" />
            </DockPanel>
            <GridSplitter x:Name="LayersSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="Transparent" DragCompleted="OnSplitterDragCompleted" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Focusable="False">
                        <Grid x:Name="ZoomHost" Margin="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                            </Grid.LayoutTransform>
                            <!-- UseLayoutRounding/SnapsToDevicePixels are OFF for the artboards and must
                                 stay off. FluentWindow switches both on at the window and they inherit:
                                 with rounding on, a skin whose scaled size lands on a half pixel is
                                 snapped and the canvas stops being a pixel-exact model of the OSD.
                                 SkinOsdWindow is deliberately not a FluentWindow, so it has no rounding. -->
                            <Grid x:Name="Artboards" UseLayoutRounding="False" SnapsToDevicePixels="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{loc:T designer.layer.volume-bar}" FontSize="11" Margin="0,0,12,0"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Border x:Name="VolumeBoard" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
                                    <TextBlock x:Name="VolumePlaceholder" Width="300" Margin="16" TextWrapping="Wrap"
                                               Foreground="#FF404040" />
                                </Border>
                                <!-- Directly under the volume bar, as SkinOsdWindow stacks them. -->
                                <TextBlock Grid.Row="1" Text="{loc:T designer.layer.airplay}" FontSize="11" Margin="0,0,12,0"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Border x:Name="AirPlayBoard" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left">
                                    <loc:AirPlayBarView x:Name="AirPlayPreview" />
                                </Border>
                                <TextBlock Grid.Row="3" Text="{loc:T designer.text.notice}" FontSize="11" Margin="0,0,12,0"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Border x:Name="NoticeBoard" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left">
                                    <loc:NoticeView x:Name="NoticePreview" />
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- View state only: none of this is part of the skin or of its history. -->
                <WrapPanel x:Name="PreviewStrip" Grid.Row="1" Margin="0,8,0,0">
                    <Button x:Name="ZoomOutButton" Content="-" Width="28" Padding="0,4" Click="OnZoomOut"
                            ToolTip="{loc:T designer.zoom.out.tooltip}" />
                    <TextBlock x:Name="ZoomText" Width="48" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button x:Name="ZoomInButton" Content="+" Width="28" Padding="0,4" Click="OnZoomIn"
                            ToolTip="{loc:T designer.zoom.in.tooltip}" />
                    <Button Content="{loc:T designer.zoom.fit.label}" Padding="10,4" Margin="6,0,0,0" Click="OnZoomFit"
                            ToolTip="{loc:T designer.zoom.fit.tooltip}" />
                    <Button Content="100%" Padding="10,4" Margin="6,0,24,0" Click="OnZoomActual"
                            ToolTip="{loc:T designer.zoom.actual.tooltip}" />
                    <TextBlock Text="{loc:T designer.text.fill-preview}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider x:Name="PreviewFill" Width="140" Minimum="0" Maximum="100" Value="62"
                            VerticalAlignment="Center" ValueChanged="OnPreviewValueChanged" />
                    <TextBlock x:Name="PreviewFillLabel" Width="40" VerticalAlignment="Center" Margin="6,0,12,0" />
                    <CheckBox x:Name="PreviewMute" Content="{loc:T designer.mute.label}" Margin="0,0,12,0"
                              Checked="OnPreviewToggled" Unchecked="OnPreviewToggled" />
                    <TextBlock Text="AirPlay" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="PreviewAirPlayMode" Width="150" SelectedIndex="0" SelectionChanged="OnPreviewModeChanged">
                        <ComboBoxItem Content="{loc:T designer.preview.connected}" />
                        <ComboBoxItem Content="{loc:T designer.preview.disconnected}" />
                        <ComboBoxItem Content="{loc:T designer.preview.no-receiver}" />
                    </ComboBox>
                    <TextBlock Text="{loc:T designer.preview.level}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <Slider x:Name="PreviewLevel" Width="100" Minimum="0" Maximum="100" Value="70"
                            VerticalAlignment="Center" ValueChanged="OnPreviewValueChanged" />
                    <TextBlock Text="{loc:T designer.preview.device}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox x:Name="PreviewDevice" Width="180" TextChanged="OnPreviewDeviceChanged" />
                </WrapPanel>
            </Grid>

            <GridSplitter x:Name="PropertiesSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="Transparent" DragCompleted="OnSplitterDragCompleted" />
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="{loc:T designer.properties.title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <!-- Padding 14: the scrollbar measures 14 wide (see the v3.1.2 note in git history). -->
                <ScrollViewer x:Name="PropertiesScroll" Focusable="False" Padding="0,0,14,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PropertiesHost" />
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <Grid x:Name="StatusBar" Grid.Row="3" Margin="12,6,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Wraps: the status line carries whole sentences, and an unwrapped TextBlock CLIPS. -->
            <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:T designer.status.text}" />
            <TextBlock x:Name="CursorText" Grid.Column="1" FontSize="11" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
