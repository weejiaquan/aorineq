<ui:FluentWindow x:Class="AorinEQ.UI.SkinDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:core="clr-namespace:AorinEQ.Core;assembly=AorinEQ.Core"
        Title="AorinEQ skin designer" Icon="/AorinEQ.ico" Width="880" Height="640"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="AorinEQ skin designer"
                     Icon="{ui:ImageIcon '/AorinEQ.ico'}" />
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- top bar: skin selector, name, zip sharing, save -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Skin:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="SkinSelect" Grid.Column="1" SelectionChanged="OnSkinSelected" />
                <TextBlock Grid.Column="2" Text="Name:" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="NameBox" Grid.Column="3" VerticalContentAlignment="Center" TextChanged="OnControlChanged" />
                <Button x:Name="ImportZipButton" Grid.Column="4" Content="Import…" Padding="10,4" Margin="12,0,0,0" Click="OnImportZip" />
                <Button x:Name="ExportZipButton" Grid.Column="5" Content="Export…" Padding="10,4" Margin="6,0,0,0" Click="OnExportZip" />
                <Button x:Name="SaveButton" Grid.Column="6" Content="Save" Padding="16,4" Margin="6,0,0,0" Click="OnSave" />
            </Grid>

            <!-- main: preview + controls -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Wide enough that no row in the options panel has to ellipsize its primary
                         content at the default window size: the widest row (Shadow + swatch + Blur
                         + Depth) needs ~285px, and the scrollbar and its gutter take 24 of the
                         370. The preview keeps the rest and never depends on it — PreviewCanvas is
                         sized in code from the image size and scale, so the split cannot change a
                         rendered pixel. -->
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <!-- Checkerboard sits behind the artwork so transparency is visible. -->
                        <!-- UseLayoutRounding/SnapsToDevicePixels are turned OFF for the whole
                             preview subtree, and must stay off. FluentWindow switches both ON at
                             the window, and they inherit: with rounding on, a skin whose scaled
                             size lands on a half pixel (seia-bar-shadow is 525 x 262.5 at scale
                             0.35) is snapped, and the preview stops being a pixel-exact model of
                             the OSD. SkinOsdWindow is deliberately NOT a FluentWindow, so it has
                             no rounding — matching it here is what keeps "what you see in the
                             designer is what the OSD draws" true, including where the v1.7.1
                             aliased fill-boundary clip falls. -->
                        <Grid x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                              UseLayoutRounding="False" SnapsToDevicePixels="False">
                            <Grid.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#FFF0F0F0">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,16,16" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#FFD4D4D4">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <RectangleGeometry Rect="0,0,8,8" />
                                                        <RectangleGeometry Rect="8,8,8,8" />
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.Background>
                            <!-- Same composition as SkinOsdWindow: empty under clipped full, text on top. -->
                            <Grid x:Name="PreviewCanvas"
                                  MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove"
                                  MouseLeftButtonUp="OnPreviewMouseUp">
                                <!-- EdgeMode=Aliased: same seam fix as SkinOsdWindow — AA'd
                                     complementary clips leak the backdrop through the boundary column. -->
                                <Image x:Name="EmptyImage" Stretch="Fill" RenderOptions.EdgeMode="Aliased" />
                                <Image x:Name="FullImage" Stretch="Fill" RenderOptions.EdgeMode="Aliased">
                                    <Image.Clip>
                                        <RectangleGeometry x:Name="FillClip" />
                                    </Image.Clip>
                                </Image>
                                <!-- Optional muted artwork, shown alone in mute preview (mirrors SkinOsdWindow). -->
                                <Image x:Name="MutedImage" Stretch="Fill" Visibility="Collapsed" />
                                <Path x:Name="PercentPath" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Cursor="SizeAll" Visibility="Collapsed" />
                                <!-- Draggable fill-range handles: where 0% and 100% sit inside the artwork. -->
                                <Border x:Name="RangeStartHandle" Width="7" HorizontalAlignment="Left"
                                        Background="#800078D7" BorderBrush="#FF0078D7" BorderThickness="1,0"
                                        Cursor="SizeWE" Visibility="Collapsed"
                                        ToolTip="0% — drag to the bar's left edge" />
                                <Border x:Name="RangeEndHandle" Width="7" HorizontalAlignment="Left"
                                        Background="#80D77800" BorderBrush="#FFD77800" BorderThickness="1,0"
                                        Cursor="SizeWE" Visibility="Collapsed"
                                        ToolTip="100% — drag to the bar's right edge" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- The options are taller than the window at any size the user can make it
                     (MinHeight 520 leaves ~400px here for ~900px of controls), so they scroll.
                     Padding on the right keeps the scrollbar beside the content instead of over
                     it; PreviewMouseWheel is handled so the wheel scrolls the panel from anywhere
                     in it (see OnOptionsWheel). Focusable=False keeps the viewer itself out of the
                     tab order, so Tab walks control to control and the viewer brings each into
                     view as it goes.

                     The padding is 14 because the scrollbar MEASURES 14 wide. At the 10 it shipped
                     with in v3.1.2 the bar covered the rightmost 4px of every full-width control in
                     the panel — a hit test over that strip returned PART_VerticalScrollBar, not the
                     text box under it. Change this only against a fresh measurement of the bar. -->
                <ScrollViewer x:Name="OptionsScroll" Grid.Column="1" Margin="12,0,0,0"
                              Padding="0,0,14,0" Focusable="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnOptionsWheel">
                    <!-- One vertical rhythm throughout: 18 above a section heading, 6 under it,
                         10 between rows, 4 between a caption and the control it captions. Every
                         row shares the panel's left edge. -->
                    <StackPanel>
                        <TextBlock Text="Images" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="PNG, sprite-sheet PNG, or GIF. All layers must share one frame size."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="empty &#8212; artwork at 0%" FontSize="11" Margin="0,0,0,4" />
                        <TextBlock x:Name="EmptyPathText" Text="&#8212;" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Browse&#8230;" Padding="10,3" Click="OnBrowseEmpty" />
                            <Button Content="Frames&#8230;" Padding="10,3" Margin="6,0,0,0" Click="OnImportEmptyFrames"
                                    ToolTip="Build a sprite sheet from a numbered PNG frame sequence (e.g. Photoshop's Export Layers to Files)" />
                        </StackPanel>

                        <TextBlock Text="full &#8212; artwork at 100%" FontSize="11" Margin="0,0,0,4" />
                        <TextBlock x:Name="FullPathText" Text="&#8212;" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Browse&#8230;" Padding="10,3" Click="OnBrowseFull" />
                            <Button Content="Frames&#8230;" Padding="10,3" Margin="6,0,0,0" Click="OnImportFullFrames"
                                    ToolTip="Build a sprite sheet from a numbered PNG frame sequence (e.g. Photoshop's Export Layers to Files)" />
                        </StackPanel>

                        <TextBlock Text="muted &#8212; optional artwork while muted" FontSize="11" Margin="0,0,0,4" />
                        <TextBlock x:Name="MutedPathText" Text="&#8212;" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Browse&#8230;" Padding="10,3" Click="OnBrowseMuted" />
                            <Button Content="Frames&#8230;" Padding="10,3" Margin="6,0,0,0" Click="OnImportMutedFrames"
                                    ToolTip="Build a sprite sheet from a numbered PNG frame sequence (e.g. Photoshop's Export Layers to Files)" />
                            <Button x:Name="ClearMutedButton" Content="Clear" Padding="10,3" Margin="6,0,0,0"
                                    Click="OnClearMuted" ToolTip="Remove the muted artwork and fall back to dimming" />
                        </StackPanel>
                        <TextBlock x:Name="ImageErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="11" TextWrapping="Wrap" />

                        <TextBlock Text="Animation" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Frames per second" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                            <TextBox x:Name="FpsBox" Grid.Column="1" Text="10" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                        </Grid>
                        <TextBlock Text="Sprite-sheet frame counts (GIFs are automatic)" FontSize="11" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="empty" FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="EmptyFramesBox" Text="1" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="full" FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="FullFramesBox" Text="1" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="muted" FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="MutedFramesBox" Text="1" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Fill range" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <TextBlock Text="Where the bar lives inside the image, in image pixels. Drag the colored handles on the preview."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0% at" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                            <TextBox x:Name="FillStartBox" Grid.Column="1" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                            <TextBlock Grid.Column="3" Text="100% at" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                            <TextBox x:Name="FillEndBox" Grid.Column="4" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                        </Grid>

                        <TextBlock Text="Preview &amp; mute" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <TextBlock Margin="0,0,0,4">
                            <Run Text="Fill preview: " /><Run x:Name="FillLabel" Text="62%" />
                        </TextBlock>
                        <Slider x:Name="FillSlider" Minimum="0" Maximum="100" Value="62"
                                ValueChanged="OnControlChanged" Margin="0,0,0,10" />
                        <CheckBox x:Name="MuteCheck" Content="Preview mute"
                                  Checked="OnControlChanged" Unchecked="OnControlChanged" Margin="0,0,0,10" />
                        <TextBlock Margin="0,0,0,4"
                                   ToolTip="Opacity of the dimmed artwork while muted &#8212; only used when the skin has no muted artwork">
                            <Run Text="Mute dim: " /><Run x:Name="MutedDimLabel" Text="0.60" />
                        </TextBlock>
                        <Slider x:Name="MutedDimSlider" Minimum="0" Maximum="1" Value="0.6"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="OnControlChanged" />

                        <TextBlock Text="Percent text" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <CheckBox x:Name="ShowNumberCheck" Content="Show number (drag it on the preview)"
                                  Checked="OnControlChanged" Unchecked="OnControlChanged" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                            <TextBox x:Name="NumberXBox" Grid.Column="1" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                            <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                            <TextBox x:Name="NumberYBox" Grid.Column="4" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                        </Grid>

                        <!-- Number text styling (enabled only while Show number is checked) -->
                        <StackPanel x:Name="TextStylePanel">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Font" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                <!-- Editable so a skin's font that isn't installed here is preserved verbatim
                                     rather than silently rewritten. -->
                                <ComboBox x:Name="FontCombo" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True"
                                          SelectionChanged="OnControlChanged" LostFocus="OnControlChanged" />
                                <TextBlock Grid.Column="3" Text="Size" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                <TextBox x:Name="FontSizeBox" Grid.Column="4" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="BoldCheck" Content="Bold" VerticalAlignment="Center" Margin="0,0,16,0"
                                          Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <TextBlock Text="Color" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                <Button x:Name="TextColorSwatch" Width="34" Height="24" Click="OnPickTextColor"
                                        ToolTip="Text color" />
                                <TextBlock Text="Align" VerticalAlignment="Center" Margin="16,0,8,0" FontSize="11"
                                           ToolTip="What X anchors: the number's left edge, center, or right edge" />
                                <ComboBox x:Name="AlignCombo" Width="86" SelectionChanged="OnControlChanged">
                                    <ComboBoxItem Content="Left" Tag="left" IsSelected="True" />
                                    <ComboBoxItem Content="Center" Tag="center" />
                                    <ComboBoxItem Content="Right" Tag="right" />
                                </ComboBox>
                            </StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="OutlineCheck" Grid.Column="0" Content="Outline" VerticalAlignment="Center"
                                          Margin="0,0,8,0" Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <Button x:Name="OutlineColorSwatch" Grid.Column="1" Width="34" Height="24" Margin="0,0,16,0"
                                        Click="OnPickOutlineColor" ToolTip="Outline color" />
                                <TextBlock Grid.Column="2" Text="Width" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                <TextBox x:Name="OutlineWidthBox" Grid.Column="3" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="ShadowCheck" Content="Shadow" VerticalAlignment="Center" Margin="0,0,8,0"
                                          Checked="OnControlChanged" Unchecked="OnControlChanged" />
                                <Button x:Name="ShadowColorSwatch" Width="34" Height="24"
                                        Click="OnPickShadowColor" ToolTip="Shadow color" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Blur" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                <!-- MinWidth 48 is the v3.1.1 floor: in the old fixed-width row
                                     these two had collapsed to 12px and 20px. The row is far wider
                                     now, but the floor stays as the guard it was measured to be. -->
                                <TextBox x:Name="ShadowBlurBox" Grid.Column="1" MinWidth="48" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                                <TextBlock Grid.Column="3" Text="Depth" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                <TextBox x:Name="ShadowDepthBox" Grid.Column="4" MinWidth="48" LostFocus="OnControlChanged" KeyDown="OnNumberBoxKeyDown" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Scale" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <TextBlock Margin="0,0,0,4">
                            <Run Text="Scale: " /><Run x:Name="ScaleLabel" Text="1.00" />
                        </TextBlock>
                        <Slider x:Name="ScaleSlider" Minimum="0.25" Maximum="4" Value="1"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="OnControlChanged" />

                        <!-- Authorship / gallery metadata. All optional: a skin with none of it
                             behaves and saves exactly as it did before 3.2. Same rhythm as the
                             sections above — 18 above the heading, 6 under it, a 4px caption over
                             each control, 10 between rows. -->
                        <TextBlock Text="Details" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <TextBlock Text="Optional. Shown in the skin picker, and used by the skin gallery when you share this skin."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="Title &#8212; the name to show, if not the folder name" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="TitleBox" MaxLength="{x:Static core:SkinMeta.MaxTitleLength}"
                                 TextChanged="OnControlChanged" Margin="0,0,0,10" />

                        <TextBlock Text="Author &#8212; who gets the credit" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="AuthorBox" MaxLength="{x:Static core:SkinMeta.MaxAuthorLength}"
                                 TextChanged="OnControlChanged" Margin="0,0,0,10" />

                        <TextBlock Text="Description" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="DescriptionBox" MaxLength="{x:Static core:SkinMeta.MaxDescriptionLength}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnControlChanged" Margin="0,0,0,10" />

                        <TextBlock Text="Version &#8212; yours for this skin, not AorinEQ's" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="VersionBox" MaxLength="{x:Static core:SkinMeta.MaxVersionLength}"
                                 TextChanged="OnControlChanged" Margin="0,0,0,10" />

                        <TextBlock Text="Tags &#8212; comma separated" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="TagsBox" TextChanged="OnControlChanged" Margin="0,0,0,10" />

                        <TextBlock Text="Source URL &#8212; https only" FontSize="11" Margin="0,0,0,4" />
                        <TextBox x:Name="SourceUrlBox" MaxLength="{x:Static core:SkinMeta.MaxSourceUrlLength}"
                                 TextChanged="OnControlChanged" />
                        <TextBlock x:Name="MetaErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="Share" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <!-- Text set from SkinShare.HostingHint in the constructor, so the wording
                             the clipboard message uses and the wording shown here cannot drift. -->
                        <TextBlock x:Name="ShareHintText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button x:Name="ShareButton" Content="Share&#8230;" Padding="10,4" Click="OnShare"
                                ToolTip="Export the zip and copy an aorineq:// install link to the clipboard" />

                        <Button x:Name="TestButton" Content="Test on desktop" Padding="10,4"
                                Margin="0,18,0,0" Click="OnTestOnDesktop" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Wraps: the status line carries whole sentences (what was exported, what was copied
                 to the clipboard and what to do with it), and an unwrapped TextBlock silently
                 CLIPS the tail rather than ellipsizing it — the reader can't even tell there was
                 more. The row is Auto-height, so wrapping costs the preview nothing. -->
            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" FontSize="11"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Pick two images (or an existing skin) to start. Change the name before saving to create a copy." />
        </Grid>
    </Grid>
</ui:FluentWindow>
