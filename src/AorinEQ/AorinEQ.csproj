<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AorinEQ</AssemblyName>
    <ApplicationIcon>AorinEQ.ico</ApplicationIcon>
    <!-- <Version> is deliberately absent: it comes from Directory.Build.props, the one place it
         is written. See the comment there before adding one back. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AorinEQ.Core\AorinEQ.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ApplicationIcon only stamps the Win32 icon on the exe (taskbar/alt-tab/Explorer). The
         same file is embedded as a WPF resource so every window's icon resolves. Most windows
         write Icon="/AorinEQ.ico"; SettingsWindow and SkinDesignerWindow write the pack form
         "/AorinEQ;component/AorinEQ.ico", because the WPF tests build those two windows under the
         test host, where a bare "/AorinEQ.ico" resolves against the host's entry assembly (which
         has no such resource) and the window fails to construct.
         The .NET SDK does NOT auto-include .ico as a WPF Resource: without this explicit item
         the XAML still compiles and the icons silently fail to resolve at runtime. The tray does
         NOT use this file — it draws its glyph at runtime (TrayGlyph). -->
    <Resource Include="AorinEQ.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The OSD's notice parts are read by the real window in the WPF tests rather than found by
         name through the visual tree, which a rename would break silently. -->
    <InternalsVisibleTo Include="AorinEQ.Tests" />
  </ItemGroup>
</Project>
