<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppIconTests loads the shipped .ico through the two frameworks that do so at runtime:
         WIC/WPF for the windows' Icon, System.Drawing for the tray's HICON. Referencing the
         assemblies directly rather than via UseWPF/UseWindowsForms keeps this project's
         implicit usings (and so every other test file) untouched. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AorinEQ.Core\AorinEQ.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The very file the app ships as its ApplicationIcon and WPF resource, so AppIconTests
         checks the shipped asset rather than a copy that could drift. -->
    <None Include="..\..\src\AorinEQ\AorinEQ.ico" Link="AorinEQ.ico"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Likewise the real Inno Setup script, so InstallerScriptTests pins the shipped installer
         rather than a copy of it. Nothing else in the build reads this file. -->
    <None Include="..\..\installer\AorinEQ.iss" Link="AorinEQ.iss"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- And the real build files, so VersionSingleSourceTests reads the version the build actually
         imports and the project bodies that must not override it. MSBuild only ever looks for
         Directory.Build.props by walking UP from a project directory, so the copy that lands in
         bin\ is inert. -->
    <None Include="..\..\Directory.Build.props" Link="Directory.Build.props"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AorinEQ\AorinEQ.csproj" Link="AorinEQ.csproj"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AorinEQ.Core\AorinEQ.Core.csproj" Link="AorinEQ.Core.csproj"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The SDK's default None glob excludes the project file itself, so this is an Include like
         the rest and not a duplicate item. -->
    <None Include="AorinEQ.Tests.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\AppIconGen\AppIconGen.csproj" Link="AppIconGen.csproj"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
