<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test collections run one at a time. This suite does not mock: it spawns schtasks.exe,
         writes the real registry, drives real COM and, in one test, sets the process-wide current
         directory. Process CWD is not a per-collection thing - while it points at a test's scratch
         folder, any child process another collection starts inherits it and HOLDS that folder open,
         so the owning test's cleanup fails with "used by another process". That was reproducible
         here roughly one run in four, and it is exactly the kind of failure that teaches people to
         re-run a red build instead of reading it. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppIconTests loads the shipped .ico through the two frameworks that do so at runtime:
         WIC/WPF for the windows' Icon, System.Drawing for the tray's HICON. Referencing the
         assemblies directly rather than via UseWPF/UseWindowsForms keeps this project's
         implicit usings (and so every other test file) untouched. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AorinEQ.Core\AorinEQ.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The very file the app ships as its ApplicationIcon and WPF resource, so AppIconTests
         checks the shipped asset rather than a copy that could drift. -->
    <None Include="..\..\src\AorinEQ\AorinEQ.ico" Link="AorinEQ.ico"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Likewise the real Inno Setup script, so InstallerScriptTests pins the shipped installer
         rather than a copy of it. Nothing else in the build reads this file. -->
    <None Include="..\..\installer\AorinEQ.iss" Link="AorinEQ.iss"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Directory.Build.props and the project files are deliberately NOT linked here:
         VersionSingleSourceTests walks the repository for them instead, because a list fixed at
         build time cannot express "no project, including one added later, redeclares the
         version". -->
  </ItemGroup>

</Project>
