<Project>

  <!-- THE ONE PLACE THE PRODUCT VERSION IS WRITTEN.

       The MSBuild SDK imports this file into every project under the repository root before the
       project's own body, so src/AorinEQ, src/AorinEQ.Core, tests/AorinEQ.Tests and tools/AppIconGen
       all build with the same <Version> without any of them naming it.

       It lives here because it used not to: the app was released as 3.3.0 while Core still declared
       3.2.0 in its own csproj, because a release bumped one file and forgot the other. Nothing
       failed - the Core assembly simply carried a version that named a build nobody shipped. A
       version that has to be typed twice will eventually be typed once.

       Do NOT re-declare <Version> in a project file. It would win (the project body is imported
       after this one) and silently restore the drift; VersionSingleSourceTests fails the build if
       anyone does, and pins this value against the version actually stamped on the built assembly.

       The installer does NOT read this file - installer/AorinEQ.iss asks ISPP for the version
       components of the exe it packages, so it can only ever name the binary it actually carries,
       and publish.ps1 refuses to publish if the two disagree. That property is deliberate and this
       change does not touch it: the chain is csproj version -> built exe -> installer. -->
  <PropertyGroup>
    <Version>3.10.0</Version>
  </PropertyGroup>

  <!-- WHETHER THIS BUILD IS A RELEASE, stamped into every assembly as AssemblyMetadata and read back
       by AorinEQ.Core.BuildInfo.

       "release" only when publish.ps1 says so (-p:AorinEQBuildKind=release); every other build -
       dotnet build, the IDE, CI's gate - is a dev build and says so in About, on the tray icon and
       in its tooltip.

       The branch is read from .git/HEAD. Nothing is stamped when that file is absent (a git
       worktree keeps .git as a file) or HEAD is detached (CI checks out a bare SHA); BuildInfo and
       BuildInfoTests apply the same rule. -->
  <PropertyGroup>
    <AorinEQBuildKind Condition="'$(AorinEQBuildKind)' == ''">dev</AorinEQBuildKind>
    <_AorinEQGitHead>$(MSBuildThisFileDirectory).git\HEAD</_AorinEQGitHead>
    <_AorinEQGitHeadText Condition="Exists('$(_AorinEQGitHead)')">$([System.IO.File]::ReadAllText('$(_AorinEQGitHead)').Trim())</_AorinEQGitHeadText>
    <AorinEQBuildBranch Condition="'$(AorinEQBuildBranch)' == '' and $(_AorinEQGitHeadText.StartsWith('ref: refs/heads/'))">$(_AorinEQGitHeadText.Substring(16))</AorinEQBuildBranch>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildKind" Value="$(AorinEQBuildKind)" />
    <AssemblyMetadata Include="BuildBranch" Value="$(AorinEQBuildBranch)" />
  </ItemGroup>

</Project>
